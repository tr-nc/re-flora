#version 450

#extension GL_GOOGLE_include_directive : require

#define GROUP_SIZE 8
#define GROUP_SIZE_3 (GROUP_SIZE * GROUP_SIZE * GROUP_SIZE)
layout(local_size_x = GROUP_SIZE, local_size_y = GROUP_SIZE, local_size_z = GROUP_SIZE) in;

layout(set = 0, binding = 0) readonly uniform U_MakeSurfaceInfo {
    uvec3 atlas_read_offset;
    uvec3 atlas_read_dim;
    uint is_crossing_boundary; // bool
}
make_surface_info;

layout(set = 0, binding = 1) buffer B_MakeSurfaceResult {
    uint active_voxel_len;
    uint active_brick_len;
    uint solid_workgroup_len;
}
make_surface_result;

layout(set = 0, binding = 2, r32ui) writeonly uniform uimage3D surface;

layout(set = 0, binding = 3, r8ui) readonly uniform uimage3D chunk_atlas;

layout(set = 0, binding = 4) buffer B_SurfaceActiveBrickFlags { uint data[]; }
surface_active_brick_flags;

layout(set = 0, binding = 5) buffer B_SurfaceActiveBrickIndices { uint data[]; }
surface_active_brick_indices;

layout(set = 0, binding = 6) readonly buffer B_SurfaceSolidWorkgroupIndices { uint data[]; }
surface_solid_workgroup_indices;

#include "../../include/config.glsl"
#include "../../include/core/definitions.glsl"
#include "../../include/core/packer.glsl"
#include "../../include/voxel_data.glsl"
// Hash-based bucket assignment (replaces blue noise const array — Metal penalty)
uint voxel_hash_bucket_from_blue_noise(ivec3 world_pos) {
    uint h = uint(world_pos.x) * 73856093u;
    h ^= uint(world_pos.y) * 19349663u;
    h ^= uint(world_pos.z) * 83492791u;
    h ^= h >> 16u;
    h *= 0x45d9f3bu;
    h ^= h >> 16u;
    return h & 0x3u;
}
#include "../../include/voxel_types.glsl"

#define SHARED_SIZE (GROUP_SIZE + 4) // 4 for halo
#define SHARED_SIZE_3 (SHARED_SIZE * SHARED_SIZE * SHARED_SIZE)
shared uint shared_data[SHARED_SIZE][SHARED_SIZE][SHARED_SIZE];

uvec3 decode_surface_workgroup_coord(uint local_workgroup_idx) {
    uvec3 grid_dim = (make_surface_info.atlas_read_dim + uvec3(GROUP_SIZE - 1u)) / GROUP_SIZE;
    return uvec3(
        local_workgroup_idx % grid_dim.x,
        local_workgroup_idx / (grid_dim.x * grid_dim.z),
        (local_workgroup_idx / grid_dim.x) % grid_dim.z
    );
}

ivec3 shared_idx_to_atlas_idx(ivec3 chunk_base, ivec3 workgroup_base, ivec3 shared_idx) {
    ivec3 atlas_idx = shared_idx + workgroup_base - ivec3(2) + chunk_base;
    return atlas_idx;
}

ivec3 local_idx_to_shared_idx(ivec3 workgroup_base, ivec3 local_idx) {
    return local_idx - (workgroup_base - ivec3(2));
}

uint load_atlas(ivec3 atlas_idx, ivec3 atlas_read_offset, ivec3 atlas_read_dim,
                bool is_crossing_boundary) {
    if (is_crossing_boundary) {
        return voxel_type_from_atlas_data(imageLoad(chunk_atlas, atlas_idx).r);
    } else {
        if (any(lessThan(atlas_idx, atlas_read_offset)) ||
            any(greaterThanEqual(atlas_idx, atlas_read_offset + atlas_read_dim))) {
            return 0;
        }
        return voxel_type_from_atlas_data(imageLoad(chunk_atlas, atlas_idx).r);
    }
}

void preload(ivec3 workgroup_base) {
    for (uint linear_idx = gl_LocalInvocationIndex; linear_idx < SHARED_SIZE_3;
         linear_idx += GROUP_SIZE_3) {

        uvec3 shared_idx;
        shared_idx.x = linear_idx % SHARED_SIZE;
        shared_idx.y = (linear_idx / SHARED_SIZE) % SHARED_SIZE;
        shared_idx.z = linear_idx / (SHARED_SIZE * SHARED_SIZE);

        ivec3 atlas_idx = shared_idx_to_atlas_idx(
            ivec3(make_surface_info.atlas_read_offset),
            workgroup_base,
            ivec3(shared_idx)
        );
        uint val = load_atlas(atlas_idx, ivec3(make_surface_info.atlas_read_offset),
                              ivec3(make_surface_info.atlas_read_dim),
                              make_surface_info.is_crossing_boundary != 0);

        shared_data[shared_idx.x][shared_idx.y][shared_idx.z] = val;
    }
}

bool is_solid(uint voxel_type) { return voxel_type != VOXEL_TYPE_EMPTY; }

uint voxel_at_local_idx(ivec3 workgroup_base, ivec3 local_idx) {
    ivec3 shared_idx = local_idx_to_shared_idx(workgroup_base, local_idx);
    return shared_data[shared_idx.x][shared_idx.y][shared_idx.z];
}

bool is_occluded(ivec3 workgroup_base, ivec3 uvi) {
    ivec3 neighbours_to_check[6] = {
        ivec3(1, 0, 0),  ivec3(-1, 0, 0), ivec3(0, 1, 0),
        ivec3(0, -1, 0), ivec3(0, 0, 1),  ivec3(0, 0, -1),
    };

    for (int i = 0; i < 6; i++) {
        ivec3 cur       = uvi + neighbours_to_check[i];
        uint voxel_type = voxel_at_local_idx(workgroup_base, cur);
        if (!is_solid(voxel_type)) {
            return false;
        }
    }
    return true;
}

void calculate_normal(out vec3 o_normal, out bool o_is_normal_valid, ivec3 workgroup_base,
                      ivec3 uvi) {
    const ivec3 min_bound = ivec3(-2);
    const ivec3 max_bound = ivec3(2);

    vec3 normal = vec3(0.0);
    for (int z = min_bound.z; z <= max_bound.z; z++) {
        for (int y = min_bound.y; y <= max_bound.y; y++) {
            for (int x = min_bound.x; x <= max_bound.x; x++) {
                ivec3 offset    = ivec3(x, y, z);
                ivec3 cur       = uvi + offset;
                uint voxel_type = voxel_at_local_idx(workgroup_base, cur);

                if (is_solid(voxel_type)) {
                    normal += vec3(offset);
                }
            }
        }
    }
    float normal_len_sq = dot(normal, normal);
    o_is_normal_valid = normal_len_sq > EPSILON * EPSILON;
    if (o_is_normal_valid) {
        o_normal = -normal * inversesqrt(normal_len_sq);
    }
}

bool normal_not_too_steep(vec3 normal, float threhold) {
    vec3 up = vec3(0.0, 1.0, 0.0);
    return dot(normal, up) > threhold;
}

uint compress_coord(ivec3 coord) {
    uint coord_compressed = coord.x;
    coord_compressed |= coord.y << 10;
    coord_compressed |= coord.z << 20;
    return coord_compressed;
}

uint compress_voxel_type_and_normal(uint voxel_type, vec3 normal, bool is_normal_valid,
                                    ivec3 world_pos) {
    uint normal_bits = pack_normal_v2(normal);
    uint hash_id     = voxel_hash_bucket_from_blue_noise(world_pos);
    return pack_voxel_surface_data(voxel_type, normal_bits, is_normal_valid, hash_id);
}

bool is_surface_top(ivec3 workgroup_base, ivec3 p) {
    return !is_solid(voxel_at_local_idx(workgroup_base, p + ivec3(0, 1, 0)));
}

void main() {
    uint workgroup_list_idx = gl_WorkGroupID.x;
    if (workgroup_list_idx >= make_surface_result.solid_workgroup_len) {
        return;
    }

    uint local_workgroup_idx = surface_solid_workgroup_indices.data[workgroup_list_idx];
    ivec3 workgroup_base = ivec3(decode_surface_workgroup_coord(local_workgroup_idx) * GROUP_SIZE);

    preload(workgroup_base);
    barrier();

    ivec3 uvi = workgroup_base + ivec3(gl_LocalInvocationID);
    if (any(greaterThanEqual(uvi, ivec3(make_surface_info.atlas_read_dim)))) {
        return;
    }

    uint voxel_type = voxel_at_local_idx(workgroup_base, uvi);
    if (!is_solid(voxel_type)) {
        return;
    }

    if (is_occluded(workgroup_base, uvi)) {
        return;
    }

    ivec3 world_pos = ivec3(make_surface_info.atlas_read_offset) + uvi;

    vec3 normal;
    bool is_normal_valid;
    calculate_normal(normal, is_normal_valid, workgroup_base, uvi);
    uint properties =
        compress_voxel_type_and_normal(voxel_type, normal, is_normal_valid, world_pos);

    atomicAdd(make_surface_result.active_voxel_len, 1);

    uvec3 brick_coord = uvec3(uvi) >> 2u;
    uint brick_dim    = make_surface_info.atlas_read_dim.x >> 2u;
    uint brick_idx = brick_coord.x + brick_coord.z * brick_dim +
                     brick_coord.y * brick_dim * brick_dim;
    uint flag_word = brick_idx >> 5u;
    uint flag_mask = 1u << (brick_idx & 31u);
    uint old_flags = atomicOr(surface_active_brick_flags.data[flag_word], flag_mask);
    if ((old_flags & flag_mask) == 0u) {
        uint active_brick_idx = atomicAdd(make_surface_result.active_brick_len, 1);
        surface_active_brick_indices.data[active_brick_idx] = brick_idx;
    }

    imageStore(surface, uvi, uvec4(properties, 0, 0, 0));
}
