#version 450

#extension GL_GOOGLE_include_directive : require

#define GROUP_SIZE 8
layout(local_size_x = GROUP_SIZE, local_size_y = GROUP_SIZE, local_size_z = GROUP_SIZE) in;

layout(set = 0, binding = 0) readonly uniform U_EditOccupancyInfo {
    vec4 edit_center_radius_vox;
    uvec3 chunk_world_offset;
    uvec3 chunk_dim;
    uint mode;
    uint flora_tick;
    uint target_age;
    uint paint_selection;
}
edit_occupancy_info;

layout(set = 0, binding = 1, r32ui) uniform uimage3D occupancy_data;

layout(set = 0, binding = 2, r32ui) readonly uniform uimage3D surface;

#include "../../include/core/hash.glsl"
#include "../../include/voxel_data.glsl"
#include "../../include/voxel_types.glsl"
#include "../../include/flora_occupancy.glsl"
#include "../../include/flora_placement.glsl"
#include "../../include/instance.glsl"

const uint OCCUPANCY_MODE_REMOVE = 0u;
const uint OCCUPANCY_MODE_ADD    = 1u;
const uint OCCUPANCY_MODE_TRIM   = 2u;
// Keep trimmed grasses visibly clipped rather than reset to the tiny rebirth edge.
// Short grass is four voxels tall, so half growth is the lowest neat cut that
// avoids a one-voxel stump with the floor-based grass height trim.
const uint OCCUPANCY_TRIM_MIN_GROWTH_PROGRESS = 128u;

bool in_chunk_local_bound(ivec3 local_pos) {
    return all(greaterThanEqual(local_pos, ivec3(0))) &&
           all(lessThan(local_pos, ivec3(edit_occupancy_info.chunk_dim)));
}

bool is_surface_plantable(uint voxel_type) { return voxel_type == VOXEL_TYPE_DIRT; }

uint flora_paint_priority(uint selection) {
    // Grass, including mixed grass and existing tall/short grass instances, is the lowest
    // priority. Special flowers share the higher paint priority so they can replace grass
    // without overwriting each other.
    if (selection == FLORA_SPECIES_LAVENDER || selection == FLORA_SPECIES_EMBER_BLOOM) {
        return 1u;
    }

    return 0u;
}

bool flora_paint_can_replace_current(uint paint_selection, uint current_occupancy) {
    if (current_occupancy == 0u) {
        return true;
    }

    uint current_selection = unpack_flora_occupancy_selection(current_occupancy);
    return flora_paint_priority(paint_selection) > flora_paint_priority(current_selection);
}

uint randomized_trim_growth_progress(uvec3 stem_world_pos, uint current_growth_progress) {
    uint min_progress = max(INSTANCE_GROWTH_PROGRESS_REBIRTH, OCCUPANCY_TRIM_MIN_GROWTH_PROGRESS);
    uint max_progress = min(edit_occupancy_info.target_age, INSTANCE_GROWTH_PROGRESS_MATURE - 1u);
    max_progress      = max(max_progress, min_progress);

    uint seed = get_instance_seed(stem_world_pos) ^ wellons_hash(edit_occupancy_info.flora_tick);
    uint span = max_progress - min_progress + 1u;
    uint randomized_progress = min_progress + (wellons_hash(seed ^ 0x9E3779B9u) % span);

    return min(current_growth_progress, randomized_progress);
}

void main() {
    ivec3 base_local = ivec3(gl_GlobalInvocationID.xyz);
    if (any(greaterThanEqual(base_local, ivec3(edit_occupancy_info.chunk_dim)))) {
        return;
    }

    vec3 base_world_center =
        vec3(edit_occupancy_info.chunk_world_offset + uvec3(base_local)) + vec3(0.5);
    vec3 delta = base_world_center - edit_occupancy_info.edit_center_radius_vox.xyz;
    float radius_sq =
        edit_occupancy_info.edit_center_radius_vox.w * edit_occupancy_info.edit_center_radius_vox.w;
    bool in_edit = dot(delta, delta) <= radius_sq;
    if (!in_edit) {
        return;
    }

    ivec3 stem_local = base_local + ivec3(0, 1, 0);
    if (!in_chunk_local_bound(stem_local)) {
        return;
    }

    if (edit_occupancy_info.mode == OCCUPANCY_MODE_REMOVE) {
        imageStore(occupancy_data, stem_local, uvec4(0u, 0u, 0u, 0u));
        return;
    }

    if (edit_occupancy_info.mode == OCCUPANCY_MODE_ADD) {
        uint surface_data = imageLoad(surface, base_local).r;
        if (surface_data == 0u) {
            return;
        }
        if (is_surface_plantable(voxel_type_from_data(surface_data))) {
            uint current_occupancy = imageLoad(occupancy_data, stem_local).r;
            if (!flora_paint_can_replace_current(edit_occupancy_info.paint_selection,
                                                 current_occupancy)) {
                return;
            }

            ivec3 world_base_pos = ivec3(edit_occupancy_info.chunk_world_offset) + base_local;
            if (!flora_sparse_paint_selection_allows(edit_occupancy_info.paint_selection,
                                                     world_base_pos)) {
                return;
            }

            uint occupancy_value = pack_flora_occupancy(
                edit_occupancy_info.paint_selection, INSTANCE_GROWTH_PROGRESS_MATURE);
            imageStore(occupancy_data, stem_local, uvec4(occupancy_value, 0u, 0u, 0u));
        }
    }

    if (edit_occupancy_info.mode == OCCUPANCY_MODE_TRIM) {
        uint current_occupancy = imageLoad(occupancy_data, stem_local).r;
        if (current_occupancy == 0u) {
            return;
        }
        uint growth_progress = unpack_flora_occupancy_growth(current_occupancy);
        uint trimmed_growth_progress = randomized_trim_growth_progress(
            edit_occupancy_info.chunk_world_offset + uvec3(stem_local), growth_progress);
        if (growth_progress > trimmed_growth_progress) {
            uint selection = unpack_flora_occupancy_selection(current_occupancy);
            uint occupancy_value = pack_flora_occupancy(selection, trimmed_growth_progress);
            imageStore(occupancy_data, stem_local, uvec4(occupancy_value, 0u, 0u, 0u));
        }
    }
}
