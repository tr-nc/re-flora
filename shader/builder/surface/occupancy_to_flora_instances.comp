#version 450

#extension GL_GOOGLE_include_directive : require

#include "../../include/flora_registry.glsl"
#include "../../include/flora_occupancy.glsl"
#include "../../include/flora_placement.glsl"

#define GROUP_SIZE 8
layout(local_size_x = GROUP_SIZE, local_size_y = GROUP_SIZE, local_size_z = GROUP_SIZE) in;

layout(set = 0, binding = 0) readonly uniform U_OccupancyToInstancesInfo {
    uvec3 chunk_world_offset;
    uvec3 chunk_dim;
    uint spawn_time_ms;
}
occupancy_to_instances_info;

layout(set = 0, binding = 1) buffer B_OccupancyToInstancesResult {
    uint flora_instance_len[MAX_FLORA_SPECIES];
    uint has_growing_flora;
}
occupancy_to_instances_result;

layout(set = 0, binding = 2, r32ui) readonly uniform uimage3D occupancy_data;

layout(set = 0, binding = 3, r32ui) readonly uniform uimage3D surface;

#include "../../include/instance.glsl"
layout(set = 1, binding = 0) writeonly buffer B_ManualFloraInstances { Instance data[]; }
manual_flora_instances;

#include "../../include/config.glsl"
#include "../../include/core/definitions.glsl"
#include "../../include/core/packer.glsl"
#include "../../include/flora_surface_planting.glsl"
#include "../../include/flora_exclusion.glsl"
#include "../../include/grass_type.glsl"
#include "../../include/voxel_data.glsl"
#include "../../include/voxel_types.glsl"

void unpack_surface_data(uint packed, out uint o_voxel_type, out vec3 o_normal) {
    o_voxel_type = voxel_type_from_data(packed);
    o_normal     = voxel_surface_normal_from_data(packed);
}

void add_flora_instance(ivec3 base_world_pos, uint species_idx, uint growth_progress,
                        uint spawn_age_ms) {
    uint write_idx = atomicAdd(occupancy_to_instances_result.flora_instance_len[species_idx], 1u);
    Instance instance;
    uint spawn_start_ms = spawn_age_ms == FLORA_OCCUPANCY_SPAWN_INACTIVE ?
                              INSTANCE_SPAWN_INACTIVE :
                              occupancy_to_instances_info.spawn_time_ms - spawn_age_ms;
    initialize_flora_instance(
        instance, uvec3(base_world_pos) - occupancy_to_instances_info.chunk_world_offset,
        growth_progress, spawn_start_ms);
    manual_flora_instances.data[flora_species_instance_offset(species_idx) + write_idx] = instance;
    if (growth_progress < INSTANCE_GROWTH_PROGRESS_MATURE) {
        atomicOr(occupancy_to_instances_result.has_growing_flora, 1u);
    }
}

bool check_surface_plantability(uint voxel_type, vec3 normal, ivec3 world_pos) {
    if (!is_flora_surface_plantable(voxel_type)) {
        return false;
    }

    vec3 up                = vec3(0.0, 1.0, 0.0);
    float surface_flatness = dot(normal, up);
    float spawn_chance     = smoothstep(0.5, 1.0, surface_flatness);
    float rng_stiffness    = flora_legacy_hash(vec2(world_pos.x + 123.0, world_pos.z + 456.0));

    return rng_stiffness <= spawn_chance;
}

bool select_flora_biome(ivec3 world_pos, out uint o_flora_type) {
    float biome_val   = cnoise_seeded(vec2(float(world_pos.x), float(world_pos.z)) * 0.02, 1337u);
    float species_rng = flora_sparse_species_rng(world_pos);

    o_flora_type = FLORA_SPECIES_TALL_GRASS;

    if (biome_val > 0.3) {
        if (species_rng < FLORA_LAVENDER_SPARSE_THRESHOLD) {
            o_flora_type = FLORA_SPECIES_LAVENDER;
        } else if (species_rng < FLORA_GRASS_DECREASED_SPARSE_THRESHOLD) {
            o_flora_type = FLORA_SPECIES_TALL_GRASS;
        } else {
            return false;
        }
    } else if (biome_val < -0.3) {
        if (species_rng < FLORA_EMBER_BLOOM_SPARSE_THRESHOLD) {
            o_flora_type = FLORA_SPECIES_EMBER_BLOOM;
        } else if (species_rng < FLORA_GRASS_DECREASED_SPARSE_THRESHOLD) {
            o_flora_type = FLORA_SPECIES_TALL_GRASS;
        } else {
            return false;
        }
    }

    return true;
}

bool select_flora_type(ivec3 world_base_pos, bool allow_any_flora, bool allow_tall_grass,
                       bool allow_short_grass, out uint o_flora_type) {
    if (!allow_any_flora) {
        if (allow_tall_grass) {
            o_flora_type = FLORA_SPECIES_TALL_GRASS;
            return true;
        }

        if (allow_short_grass) {
            o_flora_type = FLORA_SPECIES_SHORT_GRASS;
            return true;
        }

        return false;
    }

    uint biome_flora_type;
    if (!select_flora_biome(world_base_pos, biome_flora_type)) {
        if (allow_tall_grass) {
            o_flora_type = FLORA_SPECIES_TALL_GRASS;
            return true;
        }

        if (allow_short_grass) {
            o_flora_type = FLORA_SPECIES_SHORT_GRASS;
            return true;
        }

        return false;
    }

    if (biome_flora_type == FLORA_SPECIES_LAVENDER || biome_flora_type == FLORA_SPECIES_EMBER_BLOOM) {
        o_flora_type = biome_flora_type;
        return true;
    }

    if (allow_tall_grass) {
        o_flora_type = FLORA_SPECIES_TALL_GRASS;
        return true;
    }

    if (allow_short_grass) {
        o_flora_type = FLORA_SPECIES_SHORT_GRASS;
        return true;
    }

    return false;
}

bool select_grass_mix_type(bool allow_any_flora, bool allow_tall_grass,
                           bool allow_short_grass, out uint o_flora_type) {
    if (allow_any_flora || allow_tall_grass) {
        o_flora_type = FLORA_SPECIES_TALL_GRASS;
        return true;
    }

    if (allow_short_grass) {
        o_flora_type = FLORA_SPECIES_SHORT_GRASS;
        return true;
    }

    return false;
}

bool select_painted_flora_type(uint paint_selection, ivec3 world_base_pos, bool allow_any_flora,
                               bool allow_tall_grass, bool allow_short_grass,
                               out uint o_flora_type) {
    if (paint_selection == FLORA_OCCUPANCY_SELECTION_NATURAL) {
        return select_flora_type(world_base_pos, allow_any_flora, allow_tall_grass,
                                 allow_short_grass, o_flora_type);
    }

    if (paint_selection == FLORA_OCCUPANCY_SELECTION_GRASS_MIX) {
        return select_grass_mix_type(allow_any_flora, allow_tall_grass, allow_short_grass,
                                     o_flora_type);
    }

    if (paint_selection < FLORA_SPECIES_COUNT) {
        o_flora_type = paint_selection;
        return true;
    }

    return false;
}

void main() {
    ivec3 base_local = ivec3(gl_GlobalInvocationID.xyz);
    if (any(greaterThanEqual(base_local, ivec3(occupancy_to_instances_info.chunk_dim)))) {
        return;
    }

    uint occupancy_value = imageLoad(occupancy_data, base_local).r;
    if (occupancy_value == 0u) {
        return;
    }
    uint growth_progress = unpack_flora_occupancy_growth(occupancy_value);
    uint spawn_age_ms = unpack_flora_occupancy_spawn_age_ms(occupancy_value);
    uint paint_selection = unpack_flora_occupancy_selection(occupancy_value);
    bool is_authored_plant = paint_selection == FLORA_SPECIES_LAVENDER ||
                             paint_selection == FLORA_SPECIES_EMBER_BLOOM;
    if (!is_authored_plant &&
        grass_is_excluded(uvec3(base_local), occupancy_to_instances_info.chunk_dim)) {
        return;
    }

    uint surface_data = imageLoad(surface, base_local).r;
    if (surface_data == 0u) {
        return;
    }

    uint voxel_type;
    vec3 normal;
    unpack_surface_data(surface_data, voxel_type, normal);

    ivec3 world_base_pos = ivec3(occupancy_to_instances_info.chunk_world_offset) + base_local;

    bool allow_any_flora, allow_tall_grass, allow_short_grass;
    calculate_flora_density_placement(world_base_pos, allow_any_flora, allow_tall_grass,
                                      allow_short_grass);

    // Painted sparse flowers already passed the active dab's density mask when written into
    // occupancy. Rebuilding instances should preserve those accumulated paint choices instead of
    // reapplying a fixed world-space sparse mask.
    if (paint_selection != FLORA_SPECIES_LAVENDER &&
        paint_selection != FLORA_SPECIES_EMBER_BLOOM &&
        !(allow_any_flora || allow_tall_grass || allow_short_grass)) {
        return;
    }

    if (!check_surface_plantability(voxel_type, normal, world_base_pos)) {
        return;
    }

    uint flora_type;
    if (!select_painted_flora_type(paint_selection, world_base_pos, allow_any_flora,
                                   allow_tall_grass, allow_short_grass, flora_type)) {
        return;
    }

    // Exactly one flora instance can be emitted for each occupied base position.
    add_flora_instance(world_base_pos, flora_type, growth_progress, spawn_age_ms);
}
