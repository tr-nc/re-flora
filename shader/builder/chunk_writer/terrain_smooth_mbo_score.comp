#version 450
#extension GL_GOOGLE_include_directive : require

layout(local_size_x = 8, local_size_y = 8, local_size_z = 8) in;

layout(set = 0, binding = 0) readonly uniform U_TerrainSmoothMboInfo {
    uvec4 offset;
    uvec4 dim;
    vec4 center_radius;
    vec4 params;
    uvec4 threshold;
} terrain_smooth_mbo_info;

layout(set = 0, binding = 1) readonly buffer B_TerrainSmoothMboDensityA { float data[]; }
terrain_smooth_mbo_density_a;
layout(set = 0, binding = 2) buffer B_TerrainSmoothMboScores { float data[]; }
terrain_smooth_mbo_scores;
layout(set = 0, binding = 3) buffer B_TerrainSmoothMboHistogram { uint bins[]; }
terrain_smooth_mbo_histogram;
layout(set = 0, binding = 4) buffer B_TerrainSmoothMboResult {
    uvec4 counts;
    uvec4 counts_extra;
    uvec4 changed_min;
    uvec4 changed_max;
} terrain_smooth_mbo_result;
layout(set = 0, binding = 5, r8ui) readonly uniform uimage3D chunk_atlas;

#include "terrain_smooth_mbo_common.glsl"

void main() {
    uvec3 local = gl_GlobalInvocationID;
    if (any(greaterThanEqual(local, terrain_smooth_mbo_info.dim.xyz))) {
        return;
    }

    uint idx = local_index(local);
    uint voxel_type = load_voxel_type(local);
    float original = original_density(voxel_type);
    float score = original;

    if (is_candidate_voxel(local, voxel_type)) {
        float falloff = brush_falloff(local);
        float local_strength = clamp(terrain_smooth_mbo_info.params.x * falloff * 2.25, 0.0, 1.0);
        score = mix(original, terrain_smooth_mbo_density_a.data[idx], local_strength);
        if (abs(score - original) <= terrain_smooth_mbo_info.params.y * TERRAIN_SMOOTH_MBO_DEAD_SCORE_SCALE) {
            score = original;
        }

        atomicAdd(terrain_smooth_mbo_result.counts.x, 1u);
        if (is_terrain_voxel(voxel_type)) {
            atomicAdd(terrain_smooth_mbo_result.counts.y, 1u);
        }
        atomicAdd(terrain_smooth_mbo_histogram.bins[score_bin(score)], 1u);
    }

    terrain_smooth_mbo_scores.data[idx] = score;
}
