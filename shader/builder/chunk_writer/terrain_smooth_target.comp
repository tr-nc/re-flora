#version 450
#extension GL_GOOGLE_include_directive : require

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(set = 0, binding = 0) readonly uniform U_TerrainSmoothInfo {
    uvec3 offset;
    uint _pad0;
    uvec3 dim;
    uint _pad1;
    vec2 center_xz_vox;
    float brush_radius_vox;
    float kernel_radius_vox;
    float strength;
    float max_delta_vox;
    float deadband_vox;
    float _pad2;
} terrain_smooth_info;

layout(set = 0, binding = 1) buffer B_TerrainSmoothColumns { vec4 data[]; }
terrain_smooth_columns;

float column_height(uvec2 coord) {
    uint index = coord.x * terrain_smooth_info.dim.z + coord.y;
    return terrain_smooth_columns.data[index].x;
}

float column_valid(uvec2 coord) {
    uint index = coord.x * terrain_smooth_info.dim.z + coord.y;
    return terrain_smooth_columns.data[index].z;
}

void main() {
    uvec2 column = gl_GlobalInvocationID.xy;
    if (column.x >= terrain_smooth_info.dim.x || column.y >= terrain_smooth_info.dim.z) {
        return;
    }

    uint index = column.x * terrain_smooth_info.dim.z + column.y;
    vec4 entry = terrain_smooth_columns.data[index];
    if (entry.z <= 0.0) {
        terrain_smooth_columns.data[index].y = entry.x;
        return;
    }

    vec2 atlas_xz = vec2(terrain_smooth_info.offset.x + column.x, terrain_smooth_info.offset.z + column.y) + vec2(0.5);
    float center_dist = length(atlas_xz - terrain_smooth_info.center_xz_vox);
    if (center_dist > terrain_smooth_info.brush_radius_vox) {
        terrain_smooth_columns.data[index].y = entry.x;
        return;
    }

    int kernel_radius = max(1, int(ceil(terrain_smooth_info.kernel_radius_vox)));
    float weighted_sum = 0.0;
    float total_weight = 0.0;
    float kernel_sigma = max(terrain_smooth_info.kernel_radius_vox * 0.65, 1.0);

    for (int dx = -kernel_radius; dx <= kernel_radius; ++dx) {
        for (int dz = -kernel_radius; dz <= kernel_radius; ++dz) {
            ivec2 neighbour = ivec2(column) + ivec2(dx, dz);
            if (neighbour.x < 0 || neighbour.y < 0 || neighbour.x >= int(terrain_smooth_info.dim.x) ||
                neighbour.y >= int(terrain_smooth_info.dim.z)) {
                continue;
            }

            uvec2 neighbour_u = uvec2(neighbour);
            if (column_valid(neighbour_u) <= 0.0) {
                continue;
            }

            vec2 delta = vec2(dx, dz);
            float dist = length(delta);
            if (dist > terrain_smooth_info.kernel_radius_vox) {
                continue;
            }

            float weight = exp(-(dist * dist) / max(2.0 * kernel_sigma * kernel_sigma, 1.0));
            weighted_sum += column_height(neighbour_u) * weight;
            total_weight += weight;
        }
    }

    if (total_weight <= 0.0) {
        terrain_smooth_columns.data[index].y = entry.x;
        return;
    }

    float average_height = weighted_sum / total_weight;
    float brush_falloff = 1.0 - smoothstep(0.0, terrain_smooth_info.brush_radius_vox, center_dist);
    float blend = clamp(terrain_smooth_info.strength * brush_falloff, 0.0, 1.0);
    float desired = mix(entry.x, average_height, blend);
    float delta = clamp(desired - entry.x, -terrain_smooth_info.max_delta_vox, terrain_smooth_info.max_delta_vox);
    float target = entry.x + delta;
    if (abs(target - entry.x) <= terrain_smooth_info.deadband_vox) {
        target = entry.x;
    }

    terrain_smooth_columns.data[index].y = target;
}
