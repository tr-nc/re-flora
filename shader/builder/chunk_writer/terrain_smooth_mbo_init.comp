#version 450
#extension GL_GOOGLE_include_directive : require

layout(local_size_x = 8, local_size_y = 8, local_size_z = 8) in;

layout(set = 0, binding = 0) readonly uniform U_TerrainSmoothMboInfo {
    uvec4 offset;
    uvec4 dim; // xyz = local volume dim, w = histogram bin count
    vec4 center_radius; // xyz = center in atlas voxels, w = brush radius in voxels
    vec4 params; // x = strength, y = deadband voxels, zw unused
    uvec4 threshold; // x = threshold bin, y = tie hash limit, zw unused
} terrain_smooth_mbo_info;

layout(set = 0, binding = 1) buffer B_TerrainSmoothMboDensityA { float data[]; }
terrain_smooth_mbo_density_a;
layout(set = 0, binding = 2) buffer B_TerrainSmoothMboDensityB { float data[]; }
terrain_smooth_mbo_density_b;
layout(set = 0, binding = 3, r8ui) readonly uniform uimage3D chunk_atlas;

#include "terrain_smooth_mbo_common.glsl"

void main() {
    uvec3 local = gl_GlobalInvocationID;
    if (any(greaterThanEqual(local, terrain_smooth_mbo_info.dim.xyz))) {
        return;
    }

    uint idx = local_index(local);
    float density = original_density(load_voxel_type(local));
    terrain_smooth_mbo_density_a.data[idx] = density;
    terrain_smooth_mbo_density_b.data[idx] = density;
}
