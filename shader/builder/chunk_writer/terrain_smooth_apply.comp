#version 450
#extension GL_GOOGLE_include_directive : require

layout(local_size_x = 8, local_size_y = 8, local_size_z = 8) in;

layout(set = 0, binding = 0) readonly uniform U_TerrainSmoothInfo {
    uvec3 offset;
    uint _pad0;
    uvec3 dim;
    uint _pad1;
    vec2 center_xz_vox;
    float brush_radius_vox;
    float kernel_radius_vox;
    float strength;
    float max_delta_vox;
    float deadband_vox;
    float _pad2;
} terrain_smooth_info;

layout(set = 0, binding = 1) readonly buffer B_TerrainSmoothColumns { vec4 data[]; }
terrain_smooth_columns;
layout(set = 0, binding = 2, r8ui) uniform uimage3D chunk_atlas;
layout(set = 0, binding = 3) buffer B_TerrainSmoothResult { uint changed_voxel_count; }
terrain_smooth_result;
layout(set = 0, binding = 4) buffer B_SolidWorkgroupFlags { uint data[]; }
solid_workgroup_flags;

#include "../../include/voxel_data.glsl"
#include "../../include/voxel_types.glsl"
#include "../../include/solid_workgroups.glsl"

bool is_terrain_voxel(uint voxel_type) {
    return voxel_type == VOXEL_TYPE_DIRT || voxel_type == VOXEL_TYPE_SAND ||
           voxel_type == VOXEL_TYPE_ROCK;
}

uint column_index(uvec2 coord) { return coord.x * terrain_smooth_info.dim.z + coord.y; }

void main() {
    uvec3 local = gl_GlobalInvocationID;
    if (local.x >= terrain_smooth_info.dim.x || local.y >= terrain_smooth_info.dim.y ||
        local.z >= terrain_smooth_info.dim.z) {
        return;
    }

    uvec2 column = local.xz;
    vec4 entry = terrain_smooth_columns.data[column_index(column)];
    if (entry.z <= 0.0 || abs(entry.y - entry.x) <= terrain_smooth_info.deadband_vox) {
        return;
    }

    vec2 atlas_xz = vec2(terrain_smooth_info.offset.x + column.x, terrain_smooth_info.offset.z + column.y) + vec2(0.5);
    float center_dist = length(atlas_xz - terrain_smooth_info.center_xz_vox);
    if (center_dist > terrain_smooth_info.brush_radius_vox) {
        return;
    }

    ivec3 world_voxel_pos = ivec3(local) + ivec3(terrain_smooth_info.offset);
    uvec4 voxel_data = imageLoad(chunk_atlas, world_voxel_pos);
    uint voxel_type = voxel_type_from_atlas_data(voxel_data.r);
    float voxel_center_y = float(world_voxel_pos.y) + 0.5;
    float old_height = entry.x;
    float target_height = entry.y;

    if (target_height < old_height - terrain_smooth_info.deadband_vox) {
        if (voxel_center_y > target_height && voxel_center_y <= old_height && is_terrain_voxel(voxel_type)) {
            imageStore(chunk_atlas, world_voxel_pos, uvec4(pack_voxel_atlas_type_clear_state(VOXEL_TYPE_EMPTY), 0, 0, 0));
            atomicAdd(terrain_smooth_result.changed_voxel_count, 1u);
        }
        return;
    }

    if (target_height > old_height + terrain_smooth_info.deadband_vox) {
        if (voxel_center_y > old_height && voxel_center_y <= target_height) {
            if (voxel_type == VOXEL_TYPE_EMPTY) {
                imageStore(chunk_atlas, world_voxel_pos, uvec4(pack_voxel_atlas_type_clear_state(VOXEL_TYPE_DIRT), 0, 0, 0));
                mark_solid_workgroup(uvec3(world_voxel_pos));
                atomicAdd(terrain_smooth_result.changed_voxel_count, 1u);
            } else if (is_terrain_voxel(voxel_type) && voxel_type != VOXEL_TYPE_DIRT) {
                imageStore(chunk_atlas, world_voxel_pos, uvec4(pack_voxel_atlas_type_preserve_state(voxel_data.r, VOXEL_TYPE_DIRT), 0, 0, 0));
                mark_solid_workgroup(uvec3(world_voxel_pos));
                atomicAdd(terrain_smooth_result.changed_voxel_count, 1u);
            }
        }
    }
}
