#version 450
#extension GL_GOOGLE_include_directive : require

layout(local_size_x = 8, local_size_y = 8, local_size_z = 8) in;

layout(set = 0, binding = 0) readonly uniform U_ChunkSolidSampleInfo {
    uvec3 atlas_offset;
    uvec3 atlas_dim;
    uvec3 sample_dim;
}
chunk_solid_sample_info;

layout(set = 0, binding = 1, r8ui) readonly uniform uimage3D chunk_atlas;

layout(set = 0, binding = 2) buffer B_ChunkSolidSamples { uint solid[]; }
chunk_solid_samples;

#include "../../include/voxel_types.glsl"

uint sample_index(uvec3 p, uvec3 dim) { return (p.z * dim.y + p.y) * dim.x + p.x; }

uint load_voxel_type(ivec3 p) {
    ivec3 atlas_size = imageSize(chunk_atlas).xyz;
    if (any(lessThan(p, ivec3(0))) || any(greaterThanEqual(p, atlas_size))) {
        return VOXEL_TYPE_EMPTY;
    }
    return imageLoad(chunk_atlas, p).r;
}

void main() {
    uvec3 sample_id = gl_GlobalInvocationID.xyz;
    uvec3 sample_dim = chunk_solid_sample_info.sample_dim;
    if (any(greaterThanEqual(sample_id, sample_dim))) {
        return;
    }

    uvec3 source_dim = chunk_solid_sample_info.atlas_dim;
    // Use the center of each source block represented by this low-res sample.
    // For the common 256 -> 32 downsample this yields 4, 12, ..., 252 instead
    // of endpoint-aligned 0, 8, ..., 255 samples.
    uvec3 source_voxel = min(
        ((sample_id * uvec3(2) + uvec3(1)) * source_dim) / (sample_dim * uvec3(2)),
        source_dim - uvec3(1)
    );
    uvec3 atlas_voxel = chunk_solid_sample_info.atlas_offset + source_voxel;

    uint voxel_type = load_voxel_type(ivec3(atlas_voxel));
    chunk_solid_samples.solid[sample_index(sample_id, sample_dim)] =
        voxel_type == VOXEL_TYPE_EMPTY ? 0u : 1u;
}
