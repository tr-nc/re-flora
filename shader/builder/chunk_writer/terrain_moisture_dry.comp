#version 460

#extension GL_GOOGLE_include_directive : require

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

layout(push_constant) uniform PC {
    uvec4 offset;
    uvec4 dim;
    vec4 dry_params;
    vec4 sun_dir_params;
    uvec4 shadow_params;
}
pc;

#define GUI_INPUT_BINDING 0
#define GUI_INPUT_NAME manual_gui_input
#include "../../include/gui_input.glsl"

layout(set = 0, binding = 1, r8ui) uniform uimage3D chunk_atlas;
layout(set = 0, binding = 2) uniform U_ManualShadowCameraInfo {
    vec4 pos;
    mat4 view_mat;
    mat4 view_mat_inv;
    mat4 proj_mat;
    mat4 proj_mat_inv;
    mat4 view_proj_mat;
    mat4 view_proj_mat_inv;
}
manual_shadow_camera_info;
layout(set = 0, binding = 3) uniform sampler2D manual_shadow_map_tex_for_vsm_ping;
layout(set = 0, binding = 4) readonly buffer B_ManualContreeLeafData { uint data[]; }
manual_contree_leaf_data;
layout(set = 0, binding = 5) readonly buffer B_ManualSurfaceLeafCoords { uint data[]; }
manual_surface_leaf_coords;
layout(set = 0, binding = 6) readonly buffer B_ManualSurfaceLeafChunkInfo { uvec4 data[]; }
manual_surface_leaf_chunk_info;
layout(set = 0, binding = 7) uniform sampler2D manual_leaf_shadow_opacity_blended_tex;
layout(set = 0, binding = 8) uniform sampler2D manual_leaf_shadow_mask_tex;
layout(set = 0, binding = 9) uniform sampler2D manual_cloud_shadow_tex;

#include "../../include/core/aabb.glsl"
#include "../../include/core/packer.glsl"
#include "../../include/voxel_data.glsl"
#include "../../include/voxel_types.glsl"
#define shadow_camera_info manual_shadow_camera_info
#define shadow_map_tex_for_vsm_ping manual_shadow_map_tex_for_vsm_ping
#define leaf_shadow_opacity_blended_tex manual_leaf_shadow_opacity_blended_tex
#define leaf_shadow_mask_tex manual_leaf_shadow_mask_tex
#define cloud_shadow_tex manual_cloud_shadow_tex
#define gui_input manual_gui_input
#define DIRECT_SUN_SHADOW_ENABLE_LEAF
#define DIRECT_SUN_SHADOW_ENABLE_CLOUD
#include "../../include/direct_sun_shadow.glsl"
#undef gui_input
#undef cloud_shadow_tex
#undef leaf_shadow_mask_tex
#undef leaf_shadow_opacity_blended_tex
#undef shadow_map_tex_for_vsm_ping
#undef shadow_camera_info

float moisture_hash01(uvec3 p, uint seed) {
    uint h = seed ^ 0x9E3779B9u;
    h ^= p.x * 0x85EBCA6Bu;
    h ^= p.y * 0xC2B2AE35u;
    h ^= p.z * 0x27D4EB2Fu;
    h ^= h >> 16u;
    h *= 0x7FEB352Du;
    h ^= h >> 15u;
    h *= 0x846CA68Bu;
    h ^= h >> 16u;
    return float(h & 0x00FFFFFFu) * (1.0 / 16777216.0);
}

bool is_moisture_voxel(uint voxel_type) {
    return voxel_type == VOXEL_TYPE_DIRT || voxel_type == VOXEL_TYPE_SAND;
}

uint load_atlas_voxel_type(ivec3 p) {
    ivec3 atlas_size = imageSize(chunk_atlas).xyz;
    if (any(lessThan(p, ivec3(0))) || any(greaterThanEqual(p, atlas_size))) {
        return VOXEL_TYPE_EMPTY;
    }
    return voxel_type_from_atlas_data(imageLoad(chunk_atlas, p).r);
}

uint load_atlas_moisture(ivec3 p) {
    ivec3 atlas_size = imageSize(chunk_atlas).xyz;
    if (any(lessThan(p, ivec3(0))) || any(greaterThanEqual(p, atlas_size))) {
        return 0u;
    }
    uint atlas_data = imageLoad(chunk_atlas, p).r;
    uint voxel_type = voxel_type_from_atlas_data(atlas_data);
    if (!is_moisture_voxel(voxel_type)) {
        return 0u;
    }
    return voxel_moisture_from_atlas_data(atlas_data);
}

bool has_wetter_moisture_neighbor(ivec3 p, uint moisture) {
    const ivec3 neighbours_to_check[6] = {
        ivec3(1, 0, 0),  ivec3(-1, 0, 0), ivec3(0, 1, 0),
        ivec3(0, -1, 0), ivec3(0, 0, 1),  ivec3(0, 0, -1),
    };
    for (int i = 0; i < 6; i++) {
        if (load_atlas_moisture(p + neighbours_to_check[i]) > moisture) {
            return true;
        }
    }
    return false;
}

bool sun_ray_is_occluded(vec3 origin_vox, vec3 sun_dir) {
    const int SUN_SHADOW_RAY_MAX_STEPS = 768;
    const float SUN_SHADOW_RAY_STEP_VOX = 1.0;
    ivec3 atlas_size = imageSize(chunk_atlas).xyz;
    vec3 sample_pos = origin_vox + sun_dir * 0.25;
    for (int step_idx = 0; step_idx < SUN_SHADOW_RAY_MAX_STEPS; step_idx++) {
        sample_pos += sun_dir * SUN_SHADOW_RAY_STEP_VOX;
        ivec3 sample_vox = ivec3(floor(sample_pos));
        if (any(lessThan(sample_vox, ivec3(0))) || any(greaterThanEqual(sample_vox, atlas_size))) {
            return false;
        }
        if (load_atlas_voxel_type(sample_vox) != VOXEL_TYPE_EMPTY) {
            return true;
        }
    }
    return false;
}

bool shadow_camera_contains(vec3 world_pos) {
    vec4 light_space = manual_shadow_camera_info.view_proj_mat * vec4(world_pos, 1.0);
    if (abs(light_space.w) <= 1.0e-6) {
        return false;
    }
    vec3 ndc = light_space.xyz / light_space.w;
    vec2 uv = ndc.xy * 0.5 + 0.5;
    return !any(lessThan(uv, vec2(0.0))) && !any(greaterThan(uv, vec2(1.0)));
}

float direct_shadow_exposure(vec3 world_pos, uint source_mask, uint available_mask) {
    DirectSunShadowReceiver shadow_receiver = direct_sun_shadow_receiver(
        vec4(world_pos, 1.0),
        ivec3(0),
        source_mask,
        DIRECT_TERRAIN_SHADOW_VSM,
        available_mask,
        DIRECT_SUN_SHADOW_FLAG_LEAF_DEPTH_GATE
    );
    return get_direct_sun_shadow_transmittance(shadow_receiver);
}

ivec3 unpack_surface_leaf_local_coord(uint packed_coord) {
    return ivec3(
        int(packed_coord & 0x3FFu),
        int((packed_coord >> 10u) & 0x3FFu),
        int((packed_coord >> 20u) & 0x3FFu)
    );
}

vec3 surface_shadow_sample_pos(vec3 voxel_center_world, vec3 normal, float voxels_per_world_unit) {
    vec2 t = slabs(vec3(-1.0), vec3(1.0), vec3(0.0), 1.0 / normal);
    float half_voxel_size = 0.5 / voxels_per_world_unit;
    return voxel_center_world + normal * (t.y * half_voxel_size + 0.005);
}

float surface_sun_exposure(vec3 sample_world_pos, vec3 normal, vec3 sun_dir,
                           float voxels_per_world_unit, uint source_mask,
                           uint available_mask) {
    if (sun_dir.y <= 0.0 || dot(normal, sun_dir) <= 0.05) {
        return 0.0;
    }

    uint direct_source_mask = source_mask;
    float terrain_visibility = 1.0;
    bool wants_terrain = (source_mask & DIRECT_SUN_SHADOW_SOURCE_TERRAIN) != 0u;
    bool terrain_vsm_available = wants_terrain &&
                                 (available_mask & DIRECT_SUN_SHADOW_SOURCE_TERRAIN) != 0u &&
                                 shadow_camera_contains(sample_world_pos);
    if (wants_terrain && !terrain_vsm_available) {
        direct_source_mask &= ~DIRECT_SUN_SHADOW_SOURCE_TERRAIN;
        terrain_visibility = !sun_ray_is_occluded(sample_world_pos * voxels_per_world_unit,
                                                  sun_dir)
                                 ? 1.0
                                 : 0.0;
    }

    return terrain_visibility * direct_shadow_exposure(sample_world_pos, direct_source_mask,
                                                       available_mask);
}

void main() {
    uint surface_leaf_local_idx = gl_GlobalInvocationID.x;
    uint surface_leaf_count = pc.dim.x;
    uint chunk_info_idx = pc.dim.y;
    if (surface_leaf_local_idx >= surface_leaf_count) {
        return;
    }

    uvec4 chunk_info = manual_surface_leaf_chunk_info.data[chunk_info_idx];
    uint leaf_offset = chunk_info.x;
    uint leaf_count_from_info = chunk_info.y;
    bool chunk_surface_ready = chunk_info.z != 0u;
    if (!chunk_surface_ready || surface_leaf_local_idx >= leaf_count_from_info) {
        return;
    }

    uint global_leaf_idx = leaf_offset + surface_leaf_local_idx;
    ivec3 local_coord = unpack_surface_leaf_local_coord(manual_surface_leaf_coords.data[global_leaf_idx]);
    ivec3 atlas_coord = ivec3(pc.offset.xyz) + local_coord;
    ivec3 atlas_size = imageSize(chunk_atlas).xyz;
    if (any(lessThan(atlas_coord, ivec3(0))) || any(greaterThanEqual(atlas_coord, atlas_size))) {
        return;
    }

    float dry_probability = clamp(pc.dry_params.x, 0.0, 1.0);
    float residual_probability_multiplier = max(pc.dry_params.y, 1.0);
    float voxels_per_world_unit = max(pc.dry_params.z, 1.0);
    uint shadow_source_mask = pc.shadow_params.x;
    uint shadow_available_mask = pc.shadow_params.y;
    float sun_dir_len_sq = dot(pc.sun_dir_params.xyz, pc.sun_dir_params.xyz);
    vec3 sun_dir = sun_dir_len_sq > 0.0 ? pc.sun_dir_params.xyz * inversesqrt(sun_dir_len_sq) : vec3(0.0);
    float sunlit_probability_multiplier = max(pc.sun_dir_params.w, 1.0);
    if (dry_probability <= 0.0) {
        return;
    }

    uint old_data = imageLoad(chunk_atlas, atlas_coord).r;
    uint old_moisture = voxel_moisture_from_atlas_data(old_data);
    if (old_moisture == 0u) {
        return;
    }

    uint voxel_type = voxel_type_from_atlas_data(old_data);
    if (!is_moisture_voxel(voxel_type)) {
        return;
    }

    uint surface_data = manual_contree_leaf_data.data[global_leaf_idx];
    vec3 normal = voxel_surface_normal_from_data(surface_data);
    vec3 voxel_center_world = (vec3(atlas_coord) + vec3(0.5)) / voxels_per_world_unit;
    vec3 sample_world_pos =
        surface_shadow_sample_pos(voxel_center_world, normal, voxels_per_world_unit);
    float sun_exposure = surface_sun_exposure(
        sample_world_pos,
        normal,
        sun_dir,
        voxels_per_world_unit,
        shadow_source_mask,
        shadow_available_mask
    );
    dry_probability *= mix(1.0, sunlit_probability_multiplier, sun_exposure);
    dry_probability = clamp(dry_probability, 0.0, 1.0);

    uvec3 atlas_u = uvec3(atlas_coord);
    uint seed = pc.offset.w;
    float dry_roll = moisture_hash01(atlas_u, seed);
    bool should_dry = dry_roll < dry_probability;

    // A level-1 voxel can either be the natural feathered edge of fresh watering or an
    // isolated residual film. Preserve the edge while it touches wetter soil; only accelerate
    // evaporation once it has detached into residual speckles after the main patch dries.
    // Check neighbors only for rolls that need the residual fast-path, not for every edge voxel.
    if (!should_dry && old_moisture == 1u) {
        float residual_dry_probability = clamp(
            dry_probability * residual_probability_multiplier,
            0.0,
            1.0
        );
        if (dry_roll < residual_dry_probability) {
            should_dry = !has_wetter_moisture_neighbor(atlas_coord, old_moisture);
        }
    }
    if (!should_dry) {
        return;
    }

    uint new_moisture = old_moisture - 1u;
    imageStore(
        chunk_atlas,
        atlas_coord,
        uvec4(pack_voxel_atlas_moisture_preserve_state(old_data, new_moisture), 0u, 0u, 0u)
    );
}
