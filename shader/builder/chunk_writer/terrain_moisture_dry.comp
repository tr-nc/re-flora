#version 460

#extension GL_GOOGLE_include_directive : require

layout(local_size_x = 8, local_size_y = 8, local_size_z = 8) in;

layout(push_constant) uniform PC {
    uvec4 offset;
    uvec4 dim;
    vec4 dry_params;
    vec4 sun_dir_params;
}
pc;

layout(set = 0, binding = 1, r8ui) uniform uimage3D chunk_atlas;

#include "../../include/voxel_data.glsl"
#include "../../include/voxel_types.glsl"

float moisture_hash01(uvec3 p, uint seed) {
    uint h = seed ^ 0x9E3779B9u;
    h ^= p.x * 0x85EBCA6Bu;
    h ^= p.y * 0xC2B2AE35u;
    h ^= p.z * 0x27D4EB2Fu;
    h ^= h >> 16u;
    h *= 0x7FEB352Du;
    h ^= h >> 15u;
    h *= 0x846CA68Bu;
    h ^= h >> 16u;
    return float(h & 0x00FFFFFFu) * (1.0 / 16777216.0);
}

bool is_moisture_voxel(uint voxel_type) {
    return voxel_type == VOXEL_TYPE_DIRT || voxel_type == VOXEL_TYPE_SAND;
}

uint load_atlas_voxel_type(ivec3 p) {
    ivec3 atlas_size = imageSize(chunk_atlas).xyz;
    if (any(lessThan(p, ivec3(0))) || any(greaterThanEqual(p, atlas_size))) {
        return VOXEL_TYPE_EMPTY;
    }
    return voxel_type_from_atlas_data(imageLoad(chunk_atlas, p).r);
}

bool sun_ray_is_occluded(vec3 origin_vox, vec3 sun_dir) {
    const int SUN_SHADOW_RAY_MAX_STEPS = 768;
    const float SUN_SHADOW_RAY_STEP_VOX = 1.0;
    ivec3 atlas_size = imageSize(chunk_atlas).xyz;
    vec3 sample_pos = origin_vox + sun_dir * 0.25;
    for (int step_idx = 0; step_idx < SUN_SHADOW_RAY_MAX_STEPS; step_idx++) {
        sample_pos += sun_dir * SUN_SHADOW_RAY_STEP_VOX;
        ivec3 sample_vox = ivec3(floor(sample_pos));
        if (any(lessThan(sample_vox, ivec3(0))) || any(greaterThanEqual(sample_vox, atlas_size))) {
            return false;
        }
        if (load_atlas_voxel_type(sample_vox) != VOXEL_TYPE_EMPTY) {
            return true;
        }
    }
    return false;
}

struct MoistureDryExposure {
    float evaporation_factor;
    bool surface;
    bool sunlit;
};

MoistureDryExposure moisture_dry_exposure(ivec3 p, uint voxel_type, vec3 sun_dir) {
    MoistureDryExposure exposure;
    exposure.evaporation_factor = 0.0;
    exposure.surface = false;
    exposure.sunlit = false;
    if (!is_moisture_voxel(voxel_type)) {
        return exposure;
    }

    const int DRY_AIR_SEARCH_STEPS = 8;
    const ivec3 neighbours_to_check[6] = {
        ivec3(1, 0, 0),  ivec3(-1, 0, 0), ivec3(0, 1, 0),
        ivec3(0, -1, 0), ivec3(0, 0, 1),  ivec3(0, 0, -1),
    };
    int best_depth = DRY_AIR_SEARCH_STEPS;
    ivec3 best_air_dir = ivec3(0);
    for (int i = 0; i < 6; i++) {
        for (int step_idx = 1; step_idx <= DRY_AIR_SEARCH_STEPS; step_idx++) {
            if (load_atlas_voxel_type(p + neighbours_to_check[i] * step_idx) == VOXEL_TYPE_EMPTY) {
                int depth = step_idx - 1;
                if (depth < best_depth) {
                    best_depth = depth;
                    best_air_dir = neighbours_to_check[i];
                }
                break;
            }
        }
    }
    if (best_depth >= DRY_AIR_SEARCH_STEPS) {
        return exposure;
    }

    exposure.surface = best_depth == 0;
    float depth_t = float(best_depth) / float(DRY_AIR_SEARCH_STEPS);
    float depth_factor = clamp(1.0 - depth_t, 0.0, 1.0);
    exposure.evaporation_factor = depth_factor * depth_factor;

    if (exposure.surface && sun_dir.y > 0.0) {
        vec3 face_normal = vec3(best_air_dir);
        if (dot(face_normal, sun_dir) > 0.05) {
            vec3 face_origin = vec3(p) + vec3(0.5) + face_normal * 0.51;
            exposure.sunlit = !sun_ray_is_occluded(face_origin, sun_dir);
        }
    }
    return exposure;
}

void main() {
    uvec3 local = gl_GlobalInvocationID.xyz;
    uvec3 dim = pc.dim.xyz;
    if (any(greaterThanEqual(local, dim))) {
        return;
    }

    uvec3 atlas_u = pc.offset.xyz + local;
    uint seed = pc.offset.w;
    float dry_probability = clamp(pc.dry_params.x, 0.0, 1.0);
    float residual_probability_multiplier = max(pc.dry_params.y, 1.0);
    float sun_dir_len_sq = dot(pc.sun_dir_params.xyz, pc.sun_dir_params.xyz);
    vec3 sun_dir = sun_dir_len_sq > 0.0 ? pc.sun_dir_params.xyz * inversesqrt(sun_dir_len_sq) : vec3(0.0);
    float sunlit_probability_multiplier = max(pc.sun_dir_params.w, 1.0);
    if (dry_probability <= 0.0) {
        return;
    }

    uint old_data = imageLoad(chunk_atlas, ivec3(atlas_u)).r;
    uint old_moisture = voxel_moisture_from_atlas_data(old_data);
    if (old_moisture == 0u) {
        return;
    }

    uint voxel_type = voxel_type_from_atlas_data(old_data);
    MoistureDryExposure exposure = moisture_dry_exposure(ivec3(atlas_u), voxel_type, sun_dir);
    if (exposure.evaporation_factor <= 0.0) {
        return;
    }
    dry_probability *= exposure.evaporation_factor;
    if (exposure.sunlit) {
        dry_probability *= sunlit_probability_multiplier;
    }
    // A level-1 voxel represents a thin residual film. Let it evaporate faster than wetter
    // soil so the quantized moisture simulation does not leave visible single-voxel speckles
    // random-walking after the main wet patch has dried.
    if (old_moisture == 1u) {
        dry_probability *= residual_probability_multiplier;
    }
    dry_probability = clamp(dry_probability, 0.0, 1.0);
    if (moisture_hash01(atlas_u, seed) >= dry_probability) {
        return;
    }

    uint new_moisture = old_moisture - 1u;
    imageStore(
        chunk_atlas,
        ivec3(atlas_u),
        uvec4(pack_voxel_atlas_moisture_preserve_state(old_data, new_moisture), 0u, 0u, 0u)
    );
}
