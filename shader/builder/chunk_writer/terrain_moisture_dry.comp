#version 460

#extension GL_GOOGLE_include_directive : require

layout(local_size_x = 8, local_size_y = 8, local_size_z = 8) in;

// Reuse the terrain moisture brush uniform buffer layout so moisture add/dry
// passes share one small CPU-updated parameter buffer.
layout(set = 0, binding = 0) uniform U_TerrainMoistureBrushInfo {
    uvec4 offset;
    uvec4 dim;
    vec4 start_radius;
    vec4 end_amount;
}
terrain_moisture_brush_info;

layout(set = 0, binding = 1, r8ui) uniform uimage3D chunk_atlas;

#include "../../include/voxel_data.glsl"

float moisture_hash01(uvec3 p, uint seed) {
    uint h = seed ^ 0x9E3779B9u;
    h ^= p.x * 0x85EBCA6Bu;
    h ^= p.y * 0xC2B2AE35u;
    h ^= p.z * 0x27D4EB2Fu;
    h ^= h >> 16u;
    h *= 0x7FEB352Du;
    h ^= h >> 15u;
    h *= 0x846CA68Bu;
    h ^= h >> 16u;
    return float(h & 0x00FFFFFFu) * (1.0 / 16777216.0);
}

void main() {
    uvec3 local = gl_GlobalInvocationID.xyz;
    uvec3 dim = terrain_moisture_brush_info.dim.xyz;
    if (any(greaterThanEqual(local, dim))) {
        return;
    }

    uvec3 atlas_u = terrain_moisture_brush_info.offset.xyz + local;
    uint seed = terrain_moisture_brush_info.offset.w;
    float dry_probability = clamp(terrain_moisture_brush_info.start_radius.x, 0.0, 1.0);
    if (dry_probability <= 0.0) {
        return;
    }

    uint old_data = imageLoad(chunk_atlas, ivec3(atlas_u)).r;
    uint old_moisture = voxel_moisture_from_atlas_data(old_data);
    if (old_moisture == 0u) {
        return;
    }
    if (moisture_hash01(atlas_u, seed) >= dry_probability) {
        return;
    }

    uint new_moisture = old_moisture - 1u;
    imageStore(
        chunk_atlas,
        ivec3(atlas_u),
        uvec4(pack_voxel_atlas_moisture_preserve_state(old_data, new_moisture), 0u, 0u, 0u)
    );
}
