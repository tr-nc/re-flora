#version 450
#extension GL_GOOGLE_include_directive : require

layout(local_size_x = 8, local_size_y = 8, local_size_z = 8) in;

layout(set = 0, binding = 0) readonly uniform U_ModelVoxelizeInfo {
    uvec3 offset;
    uint triangle_count;
    uvec3 dim;
    uint fill_voxel_type;
    vec3 position_vox;
    float surface_thickness_vox;
}
model_voxelize_info;

layout(set = 0, binding = 1) readonly buffer B_ModelTriangles { vec4 data[]; }
model_triangles;

layout(set = 0, binding = 2, r8ui) uniform uimage3D chunk_atlas;

layout(set = 0, binding = 3) buffer B_SolidWorkgroupFlags { uint data[]; }
solid_workgroup_flags;

#include "../../include/voxel_data.glsl"
#include "../../include/voxel_types.glsl"
#include "../../include/solid_workgroups.glsl"

bool in_atlas_bound(ivec3 p) {
    ivec3 atlas_dim = imageSize(chunk_atlas).xyz;
    return all(greaterThanEqual(p, ivec3(0))) && all(lessThan(p, atlas_dim));
}

float signed_solid_angle(vec3 p, vec3 a, vec3 b, vec3 c) {
    const float EPS = 1e-7;
    vec3 va = a - p;
    vec3 vb = b - p;
    vec3 vc = c - p;
    float la = length(va);
    float lb = length(vb);
    float lc = length(vc);
    if (la < EPS || lb < EPS || lc < EPS) {
        return 0.0;
    }

    float numerator = dot(va, cross(vb, vc));
    float denominator = la * lb * lc + dot(va, vb) * lc +
                        dot(vb, vc) * la + dot(vc, va) * lb;
    if (abs(numerator) < EPS && abs(denominator) < EPS) {
        return 0.0;
    }

    return 2.0 * atan(numerator, denominator);
}

float sqr_distance_point_triangle(vec3 p, vec3 a, vec3 b, vec3 c) {
    vec3 ab = b - a;
    vec3 ac = c - a;
    vec3 ap = p - a;

    float d1 = dot(ab, ap);
    float d2 = dot(ac, ap);
    if (d1 <= 0.0 && d2 <= 0.0) {
        return dot(ap, ap);
    }

    vec3 bp = p - b;
    float d3 = dot(ab, bp);
    float d4 = dot(ac, bp);
    if (d3 >= 0.0 && d4 <= d3) {
        return dot(bp, bp);
    }

    float vc = d1 * d4 - d3 * d2;
    if (vc <= 0.0 && d1 >= 0.0 && d3 <= 0.0) {
        float v = d1 / (d1 - d3);
        vec3 closest = a + v * ab;
        vec3 delta = p - closest;
        return dot(delta, delta);
    }

    vec3 cp = p - c;
    float d5 = dot(ab, cp);
    float d6 = dot(ac, cp);
    if (d6 >= 0.0 && d5 <= d6) {
        return dot(cp, cp);
    }

    float vb = d5 * d2 - d1 * d6;
    if (vb <= 0.0 && d2 >= 0.0 && d6 <= 0.0) {
        float w = d2 / (d2 - d6);
        vec3 closest = a + w * ac;
        vec3 delta = p - closest;
        return dot(delta, delta);
    }

    float va = d3 * d6 - d5 * d4;
    if (va <= 0.0 && (d4 - d3) >= 0.0 && (d5 - d6) >= 0.0) {
        float w = (d4 - d3) / ((d4 - d3) + (d5 - d6));
        vec3 closest = b + w * (c - b);
        vec3 delta = p - closest;
        return dot(delta, delta);
    }

    vec3 normal = normalize(cross(ab, ac));
    float dist = dot(p - a, normal);
    return dist * dist;
}

void main() {
    uvec3 uvi = gl_GlobalInvocationID.xyz;
    if (any(greaterThanEqual(uvi, model_voxelize_info.dim))) {
        return;
    }

    ivec3 world_voxel_pos = ivec3(model_voxelize_info.offset + uvi);
    if (!in_atlas_bound(world_voxel_pos)) {
        return;
    }

    vec3 center = vec3(world_voxel_pos) + vec3(0.5);
    const float INSIDE_SOLID_ANGLE_THRESHOLD = 6.28318530718;
    float total_solid_angle = 0.0;
    bool near_surface = false;
    float surface_threshold_sqr = model_voxelize_info.surface_thickness_vox *
                                  model_voxelize_info.surface_thickness_vox;

    for (uint i = 0u; i < model_voxelize_info.triangle_count; i++) {
        uint base = i * 3u;
        vec3 a = model_triangles.data[base + 0u].xyz * 256.0 + model_voxelize_info.position_vox;
        vec3 b = model_triangles.data[base + 1u].xyz * 256.0 + model_voxelize_info.position_vox;
        vec3 c = model_triangles.data[base + 2u].xyz * 256.0 + model_voxelize_info.position_vox;

        total_solid_angle += signed_solid_angle(center, a, b, c);
        if (!near_surface && sqr_distance_point_triangle(center, a, b, c) <= surface_threshold_sqr) {
            near_surface = true;
        }
    }

    if (abs(total_solid_angle) > INSIDE_SOLID_ANGLE_THRESHOLD || near_surface) {
        imageStore(chunk_atlas, world_voxel_pos, uvec4(pack_voxel_atlas_type_clear_state(model_voxelize_info.fill_voxel_type), 0, 0, 0));
        if (model_voxelize_info.fill_voxel_type != VOXEL_TYPE_EMPTY) {
            mark_solid_workgroup(uvec3(world_voxel_pos));
        }
    }
}
