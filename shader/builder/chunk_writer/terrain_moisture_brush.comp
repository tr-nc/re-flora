#version 460

#extension GL_GOOGLE_include_directive : require

layout(local_size_x = 8, local_size_y = 8, local_size_z = 8) in;

layout(push_constant) uniform PC {
    uvec4 offset;
    uvec4 dim;
    vec4 start_radius;
    vec4 end_amount;
}
pc;

layout(set = 0, binding = 1, r8ui) uniform uimage3D chunk_atlas;

#include "../../include/voxel_data.glsl"
#include "../../include/voxel_types.glsl"

bool is_moisture_voxel(uint voxel_type) {
    return voxel_type == VOXEL_TYPE_DIRT || voxel_type == VOXEL_TYPE_SAND;
}

uint load_atlas_voxel_type(ivec3 p) {
    ivec3 atlas_size = imageSize(chunk_atlas).xyz;
    if (any(lessThan(p, ivec3(0))) || any(greaterThanEqual(p, atlas_size))) {
        return VOXEL_TYPE_EMPTY;
    }
    return voxel_type_from_atlas_data(imageLoad(chunk_atlas, p).r);
}

float near_surface_absorption_factor(ivec3 p, uint voxel_type) {
    if (!is_moisture_voxel(voxel_type)) {
        return 0.0;
    }

    const int WATERING_SURFACE_SEARCH_STEPS = 5;
    const ivec3 neighbours_to_check[6] = {
        ivec3(1, 0, 0),  ivec3(-1, 0, 0), ivec3(0, 1, 0),
        ivec3(0, -1, 0), ivec3(0, 0, 1),  ivec3(0, 0, -1),
    };
    int best_depth = WATERING_SURFACE_SEARCH_STEPS;
    for (int i = 0; i < 6; i++) {
        for (int step_idx = 1; step_idx <= WATERING_SURFACE_SEARCH_STEPS; step_idx++) {
            if (load_atlas_voxel_type(p + neighbours_to_check[i] * step_idx) == VOXEL_TYPE_EMPTY) {
                best_depth = min(best_depth, step_idx - 1);
                break;
            }
        }
    }
    if (best_depth >= WATERING_SURFACE_SEARCH_STEPS) {
        return 0.0;
    }

    float depth_t = float(best_depth) / float(WATERING_SURFACE_SEARCH_STEPS);
    float factor = clamp(1.0 - depth_t, 0.0, 1.0);
    return factor * factor;
}

float distance_to_segment(vec3 point, vec3 start, vec3 end) {
    vec3 ab = end - start;
    float len_sq = dot(ab, ab);
    if (len_sq <= 1.0e-5) {
        return length(point - start);
    }
    float t = clamp(dot(point - start, ab) / len_sq, 0.0, 1.0);
    vec3 closest = start + ab * t;
    return length(point - closest);
}

float moisture_hash01(uvec3 p, uint seed) {
    uint h = seed ^ 0x9E3779B9u;
    h ^= p.x * 0x85EBCA6Bu;
    h ^= p.y * 0xC2B2AE35u;
    h ^= p.z * 0x27D4EB2Fu;
    h ^= h >> 16u;
    h *= 0x7FEB352Du;
    h ^= h >> 15u;
    h *= 0x846CA68Bu;
    h ^= h >> 16u;
    return float(h & 0x00FFFFFFu) * (1.0 / 16777216.0);
}

void main() {
    uvec3 local = gl_GlobalInvocationID.xyz;
    uvec3 dim   = pc.dim.xyz;
    bool directional_pair = pc.dim.w != 0u;
    if (any(greaterThanEqual(local, dim))) {
        return;
    }

    uvec3 atlas_u = pc.offset.xyz + local;
    uint dither_seed = pc.offset.w;
    vec3 start_vox = pc.start_radius.xyz;
    float radius_vox = max(pc.start_radius.w, 0.0);
    vec3 end_vox = pc.end_amount.xyz;
    float amount = clamp(pc.end_amount.w, 0.0, 1.0);
    if (radius_vox <= 0.0 || amount <= 0.0) {
        return;
    }

    vec3 voxel_center = vec3(atlas_u) + vec3(0.5);
    float dist;
    if (directional_pair) {
        vec2 axis = end_vox.xz - start_vox.xz;
        float range_vox = length(axis);
        vec2 offset = voxel_center.xz - start_vox.xz;
        dist = length(offset);
        if (range_vox <= 1.0e-5 || dist > range_vox) {
            return;
        }
        if (dist > 1.0e-5) {
            float alignment = abs(dot(offset / dist, axis / range_vox));
            const float COS_45_DEGREES = 0.70710678;
            if (alignment < COS_45_DEGREES) {
                return;
            }
        }
        radius_vox = range_vox;
    } else {
        dist = distance_to_segment(voxel_center, start_vox, end_vox);
        if (dist > radius_vox) {
            return;
        }
    }

    uint old_data = imageLoad(chunk_atlas, ivec3(atlas_u)).r;
    uint voxel_type = voxel_type_from_atlas_data(old_data);
    float absorption_factor = near_surface_absorption_factor(ivec3(atlas_u), voxel_type);
    if (absorption_factor <= 0.0) {
        return;
    }

    // Four discrete moisture states are stored in two bits. Use a full-radius linear falloff,
    // then dither before stochastic quantization so a stroke keeps the center-to-edge gradient
    // without drawing perfectly regular rings in voxel space.
    float falloff = clamp(1.0 - dist / max(radius_vox, 0.0001), 0.0, 1.0);
    float fine_noise = moisture_hash01(atlas_u, dither_seed);
    float coarse_noise = moisture_hash01(atlas_u / 4u, dither_seed ^ 0xA511E9B3u);
    float noisy_falloff = clamp(falloff + (mix(fine_noise, coarse_noise, 0.35) - 0.5) * 0.28, 0.0, 1.0);
    float continuous_add = amount * noisy_falloff * absorption_factor * float(VOXEL_MOISTURE_MAX);
    uint add_moisture = uint(floor(continuous_add));
    if (moisture_hash01(atlas_u, dither_seed ^ 0x68BC21EBu) < fract(continuous_add)) {
        add_moisture += 1u;
    }
    if (add_moisture == 0u) {
        return;
    }

    uint old_moisture = voxel_moisture_from_atlas_data(old_data);
    uint new_moisture = min(VOXEL_MOISTURE_MAX, old_moisture + add_moisture);
    if (new_moisture == old_moisture) {
        return;
    }

    imageStore(chunk_atlas, ivec3(atlas_u), uvec4(pack_voxel_atlas_moisture_preserve_state(old_data, new_moisture), 0u, 0u, 0u));
}
