#version 460

#extension GL_GOOGLE_include_directive : require

layout(local_size_x = 8, local_size_y = 8, local_size_z = 8) in;

layout(push_constant) uniform PC {
    uvec4 offset;
    uvec4 dim;
    vec4 spread_params;
    uvec4 phase_params;
}
pc;

layout(set = 0, binding = 1, r8ui) uniform uimage3D chunk_atlas;

#include "../../include/voxel_data.glsl"
#include "../../include/voxel_types.glsl"

bool is_moisture_voxel(uint voxel_type) {
    return voxel_type == VOXEL_TYPE_DIRT || voxel_type == VOXEL_TYPE_SAND;
}

float moisture_hash01(uvec3 p, uint seed) {
    uint h = seed ^ 0x9E3779B9u;
    h ^= p.x * 0x85EBCA6Bu;
    h ^= p.y * 0xC2B2AE35u;
    h ^= p.z * 0x27D4EB2Fu;
    h ^= h >> 16u;
    h *= 0x7FEB352Du;
    h ^= h >> 15u;
    h *= 0x846CA68Bu;
    h ^= h >> 16u;
    return float(h & 0x00FFFFFFu) * (1.0 / 16777216.0);
}

uvec3 axis_offset(uint axis) {
    if (axis == 0u) {
        return uvec3(1u, 0u, 0u);
    }
    if (axis == 1u) {
        return uvec3(0u, 1u, 0u);
    }
    return uvec3(0u, 0u, 1u);
}

uint axis_coord(uvec3 p, uint axis) {
    if (axis == 0u) {
        return p.x;
    }
    if (axis == 1u) {
        return p.y;
    }
    return p.z;
}

void main() {
    uvec3 local = gl_GlobalInvocationID.xyz;
    uvec3 dim = pc.dim.xyz;
    if (any(greaterThanEqual(local, dim))) {
        return;
    }

    uvec3 atlas_u = pc.offset.xyz + local;
    uint seed = pc.offset.w;
    float spread_probability = clamp(pc.spread_params.x, 0.0, 1.0);
    float mobility_exponent = max(pc.spread_params.y, 1.0);
    float downward_multiplier = max(pc.spread_params.z, 0.0);
    float upward_multiplier = max(pc.spread_params.w, 0.0);
    if (spread_probability <= 0.0) {
        return;
    }

    uint axis = min(pc.phase_params.x, 2u);
    uint pair_parity = pc.phase_params.y & 1u;
    if ((axis_coord(atlas_u, axis) & 1u) != pair_parity) {
        return;
    }

    uvec3 neighbour_u = atlas_u + axis_offset(axis);
    uvec3 atlas_size = uvec3(imageSize(chunk_atlas).xyz);
    if (any(greaterThanEqual(neighbour_u, atlas_size))) {
        return;
    }

    uint a_data = imageLoad(chunk_atlas, ivec3(atlas_u)).r;
    uint b_data = imageLoad(chunk_atlas, ivec3(neighbour_u)).r;
    uint a_type = voxel_type_from_atlas_data(a_data);
    uint b_type = voxel_type_from_atlas_data(b_data);
    if (!is_moisture_voxel(a_type) || !is_moisture_voxel(b_type)) {
        return;
    }

    uint a_moisture = voxel_moisture_from_atlas_data(a_data);
    uint b_moisture = voxel_moisture_from_atlas_data(b_data);
    if (a_moisture == b_moisture) {
        return;
    }

    uint difference = a_moisture > b_moisture ? a_moisture - b_moisture : b_moisture - a_moisture;
    uint source_moisture = max(a_moisture, b_moisture);
    float gradient_factor = float(difference) / float(VOXEL_MOISTURE_MAX);
    // Unsaturated soil has much lower hydraulic conductivity. This keeps the last single
    // moisture quantum from random-walking across dry soil for a long time, while saturated
    // voxels still spread quickly.
    float source_saturation = float(source_moisture) / float(VOXEL_MOISTURE_MAX);
    float unsaturated_mobility = pow(source_saturation, mobility_exponent);

    // Vertical flow approximates gravity-driven percolation plus weaker capillary rise.
    // The pair is atlas_u -> atlas_u + axis_offset(axis), so on the Y axis b is above a.
    // Level-1 residual moisture remains nearly unbiased; wetter/free water is biased down.
    float directional_bias = 1.0;
    if (axis == 1u) {
        float free_water = clamp((float(source_moisture) - 1.0) / max(float(VOXEL_MOISTURE_MAX - 1u), 1.0), 0.0, 1.0);
        bool source_is_above = b_moisture > a_moisture;
        float saturated_directional_bias = source_is_above ? downward_multiplier : upward_multiplier;
        directional_bias = mix(1.0, saturated_directional_bias, free_water);
    }

    float transfer_probability = clamp(
        spread_probability * gradient_factor * unsaturated_mobility * directional_bias,
        0.0,
        1.0
    );
    if (moisture_hash01(atlas_u ^ (neighbour_u * 1664525u), seed) >= transfer_probability) {
        return;
    }

    if (a_moisture > b_moisture) {
        a_moisture -= 1u;
        b_moisture += 1u;
    } else {
        a_moisture += 1u;
        b_moisture -= 1u;
    }

    imageStore(
        chunk_atlas,
        ivec3(atlas_u),
        uvec4(pack_voxel_atlas_moisture_preserve_state(a_data, a_moisture), 0u, 0u, 0u)
    );
    imageStore(
        chunk_atlas,
        ivec3(neighbour_u),
        uvec4(pack_voxel_atlas_moisture_preserve_state(b_data, b_moisture), 0u, 0u, 0u)
    );
}
