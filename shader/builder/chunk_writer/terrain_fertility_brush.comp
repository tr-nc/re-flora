#version 460

#extension GL_GOOGLE_include_directive : require

layout(local_size_x = 8, local_size_y = 8, local_size_z = 8) in;

layout(push_constant) uniform PC {
    uvec4 offset;
    uvec4 dim;
    vec4 start_radius;
    vec4 end_amount;
}
pc;

layout(set = 0, binding = 1, r8ui) uniform uimage3D chunk_atlas;

#include "../../include/voxel_data.glsl"
#include "../../include/voxel_types.glsl"

bool is_fertility_voxel(uint voxel_type) {
    return voxel_type == VOXEL_TYPE_DIRT || voxel_type == VOXEL_TYPE_SAND;
}

uint load_atlas_voxel_type(ivec3 p) {
    ivec3 atlas_size = imageSize(chunk_atlas).xyz;
    if (any(lessThan(p, ivec3(0))) || any(greaterThanEqual(p, atlas_size))) {
        return VOXEL_TYPE_EMPTY;
    }
    return voxel_type_from_atlas_data(imageLoad(chunk_atlas, p).r);
}

bool is_surface_fertility_voxel(ivec3 p, uint voxel_type) {
    if (!is_fertility_voxel(voxel_type)) {
        return false;
    }

    const ivec3 neighbours_to_check[6] = {
        ivec3(1, 0, 0),  ivec3(-1, 0, 0), ivec3(0, 1, 0),
        ivec3(0, -1, 0), ivec3(0, 0, 1),  ivec3(0, 0, -1),
    };
    for (int i = 0; i < 6; i++) {
        if (load_atlas_voxel_type(p + neighbours_to_check[i]) == VOXEL_TYPE_EMPTY) {
            return true;
        }
    }
    return false;
}

float distance_to_segment(vec3 point, vec3 start, vec3 end) {
    vec3 ab = end - start;
    float len_sq = dot(ab, ab);
    if (len_sq <= 1.0e-5) {
        return length(point - start);
    }
    float t = clamp(dot(point - start, ab) / len_sq, 0.0, 1.0);
    vec3 closest = start + ab * t;
    return length(point - closest);
}

float fertility_hash01(uvec3 p, uint seed) {
    uint h = seed ^ 0x9E3779B9u;
    h ^= p.x * 0x85EBCA6Bu;
    h ^= p.y * 0xC2B2AE35u;
    h ^= p.z * 0x27D4EB2Fu;
    h ^= h >> 16u;
    h *= 0x7FEB352Du;
    h ^= h >> 15u;
    h *= 0x846CA68Bu;
    h ^= h >> 16u;
    return float(h & 0x00FFFFFFu) * (1.0 / 16777216.0);
}

void main() {
    uvec3 local = gl_GlobalInvocationID.xyz;
    uvec3 dim   = pc.dim.xyz;
    if (any(greaterThanEqual(local, dim))) {
        return;
    }

    uvec3 atlas_u = pc.offset.xyz + local;
    uint dither_seed = pc.offset.w;
    vec3 start_vox = pc.start_radius.xyz;
    float radius_vox = max(pc.start_radius.w, 0.0);
    vec3 end_vox = pc.end_amount.xyz;
    float amount = clamp(pc.end_amount.w, 0.0, 1.0);
    if (radius_vox <= 0.0 || amount <= 0.0) {
        return;
    }

    vec3 voxel_center = vec3(atlas_u) + vec3(0.5);
    float dist = distance_to_segment(voxel_center, start_vox, end_vox);
    if (dist > radius_vox) {
        return;
    }

    uint old_data = imageLoad(chunk_atlas, ivec3(atlas_u)).r;
    uint voxel_type = voxel_type_from_atlas_data(old_data);
    if (!is_surface_fertility_voxel(ivec3(atlas_u), voxel_type)) {
        return;
    }

    // Four discrete fertility states are stored in two bits. Match the watering brush's
    // falloff + dither so fertilizer strokes blend softly instead of drawing hard rings.
    float falloff = clamp(1.0 - dist / max(radius_vox, 0.0001), 0.0, 1.0);
    float fine_noise = fertility_hash01(atlas_u, dither_seed);
    float coarse_noise = fertility_hash01(atlas_u / 4u, dither_seed ^ 0xA511E9B3u);
    float noisy_falloff = clamp(falloff + (mix(fine_noise, coarse_noise, 0.35) - 0.5) * 0.28, 0.0, 1.0);
    float continuous_add = amount * noisy_falloff * float(VOXEL_FERTILITY_MAX);
    uint add_fertility = uint(floor(continuous_add));
    if (fertility_hash01(atlas_u, dither_seed ^ 0x68BC21EBu) < fract(continuous_add)) {
        add_fertility += 1u;
    }
    if (add_fertility == 0u) {
        return;
    }

    uint old_fertility = voxel_fertility_from_atlas_data(old_data);
    uint new_fertility = min(VOXEL_FERTILITY_MAX, old_fertility + add_fertility);
    if (new_fertility == old_fertility) {
        return;
    }

    imageStore(chunk_atlas, ivec3(atlas_u), uvec4(pack_voxel_atlas_fertility_preserve_state(old_data, new_fertility), 0u, 0u, 0u));
}
