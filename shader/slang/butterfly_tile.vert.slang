import butterfly_mesh_types;
import tracer_types;
[[vk::binding(3,0)]] ConstantBuffer<U_CameraInfo> camera_info;
[[vk::binding(72,0)]] StructuredBuffer<ButterflyMeshInstance> butterfly_mesh_instances;
struct VertexOutput {
    float4 position : SV_Position;
    [[vk::location(0)]] float2 uv : TEXCOORD0;
    [[vk::location(1)]] nointerpolation uint instanceIndex : TEXCOORD1;
};
struct VertexInput {
    [[vk::location(0)]] uint packed_data : TEXCOORD0;
    [[vk::location(1)]] uint instance_index : TEXCOORD1;
};
// Use the engine's existing vertex/instance streams rather than requiring the
// optional shaderDrawParameters capability generated by HLSL SV_*ID semantics.
[shader("vertex")]
VertexOutput main(VertexInput input) {
    uint instanceIndex=input.instance_index;
    float4 bounds=butterflyTileBounds(butterfly_mesh_instances[instanceIndex],camera_info);
    VertexOutput output;
    output.uv=float2((input.packed_data>>21u)&1u,(input.packed_data>>22u)&1u);
    output.position=float4(lerp(bounds.xy,bounds.zw,output.uv),0.0,1.0);
    output.instanceIndex=instanceIndex;
    return output;
}
