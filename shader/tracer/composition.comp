mat3 _make_tbn(vec3 normal, float sun_azimuth) {
    if (abs(normal.y) < 0.99999) {
        vec3 up = vec3(0, 1, 0);
        vec3 t  = normalize(cross(up, normal));
        vec3 b  = cross(normal, t);
        return mat3(t, b, normal);
    } else {
        // azimuth ranges from 0-1
        float angle = sun_azimuth * 2.0 * PI;
        // to remove the discontinuity, the tangent vector must be defined consistently
        // with the general case. The coordinate system (azimuth from +Z to +X)
        // requires a tangent of (cos(angle), 0, -sin(angle)).
        // the original code's `+sin(angle)` caused the discontinuous flip.
        vec3 t = vec3(cos(angle), 0.0, -sin(angle));

        // the bitangent 'b' is calculated as before to complete the right-handed basis.
        vec3 b = cross(normal, t);

        return mat3(t, b, normal);
    }
}

vec4 _sample_sun_sprite(vec3 view_dir, vec3 sun_dir, float sun_size) {
    if (dot(view_dir, sun_dir) <= 0.0) {
        return vec4(0.0);
    }

    vec3 view_dir_vs = normalize((camera_info.view_mat * vec4(view_dir, 0.0)).xyz);
    vec3 sun_dir_vs  = normalize((camera_info.view_mat * vec4(sun_dir, 0.0)).xyz);
    float view_z     = -view_dir_vs.z;
    float sun_z      = -sun_dir_vs.z;
    if (view_z <= 1e-5 || sun_z <= 1e-5) {
        return vec4(0.0);
    }

    vec2 view_proj = view_dir_vs.xy / view_z;
    vec2 sun_proj  = sun_dir_vs.xy / sun_z;
    vec2 uv        = (view_proj - sun_proj) / max(sun_size, 0.0001) + vec2(0.5);
    if (any(lessThan(uv, vec2(0.0))) || any(greaterThan(uv, vec2(1.0)))) {
        return vec4(0.0);
    }

    return texture(sun_sprite_tex, uv);
}

vec3 compute_sky_with_sun_and_stars(vec3 view_dir) {
    vec3 sky_color       = get_sky_color(view_dir, sun_info.sun_dir);
    vec4 sun_texel       = _sample_sun_sprite(view_dir, sun_info.sun_dir, sun_info.sun_size);
    float sun_day_factor = sun_luminance_from_dir(sun_info.sun_dir, 1.0);
    vec3 sun_color       = sun_texel.rgb * sun_info.sun_color;
    sun_color *= sun_info.sun_display_luminance * sun_day_factor;
    float sun_alpha   = sun_texel.a * sun_day_factor;
    vec3 sky_with_sun = mix(sky_color, sun_color, sun_alpha);

    // star visibility thresholds based on sun altitude
    const float star_cutoff_altitude =
        -0.05; // Stars completely hidden when sun is above this altitude
    const float star_fade_altitude = -0.4; // Stars fully visible when sun is below this altitude

    float sun_altitude = sun_info.sun_dir.y;

    // skip expensive star calculation when sun is too high
    if (sun_altitude > star_cutoff_altitude) {
        return sky_with_sun;
    }

    // calculate star light contribution
    StarlightInfo info =
        StarlightInfo(starlight_info.iterations, starlight_info.formuparam, starlight_info.volsteps,
                      starlight_info.stepsize, starlight_info.zoom, starlight_info.tile,
                      starlight_info.speed, starlight_info.brightness, starlight_info.darkmatter,
                      starlight_info.distfading, starlight_info.saturation);

    vec3 rotated_view_dir = transpose(_make_tbn(sun_info.sun_dir, sun_info.sun_azimuth)) * view_dir;
    vec3 star_color       = get_starlight_color(rotated_view_dir, info);

    // fade stars based on sun altitude
    float star_visibility = smoothstep(star_cutoff_altitude, star_fade_altitude, sun_altitude);
    return mix(sky_with_sun, star_color, star_visibility);
}

vec3 compute_sky_reflection_with_clouds(vec3 view_dir) {
    vec3 sky_color = compute_sky_with_sun_and_stars(view_dir);
    if (gui_input.clouds_enabled == 0u) {
        return sky_color;
    }

    uint reflection_steps = max(3u, min(gui_input.cloud_primary_steps / 2u, 8u));
    CloudRaymarchResult clouds = compute_volumetric_clouds(view_dir, reflection_steps);
    return apply_cloud_result(sky_color, clouds);
}

vec3 apply_screen_clouds(vec3 sky_color, vec2 screen_uv) {
    if (gui_input.clouds_enabled == 0u) {
        return sky_color;
    }

    vec4 clouds = texture(cloud_output_tex, screen_uv);
    return mix(sky_color, clouds.rgb, clamp(clouds.a, 0.0, 1.0));
}

vec3 combine_colors(float gfx_depth_01, float compute_depth_01, vec4 gfx_rgba,
                    vec3 denoiser_output_color, vec2 screen_uv) {
    bool has_raster = (gfx_rgba.a > 0.0) && (gfx_depth_01 < 1.0);
    bool has_rt     = compute_depth_01 < 1.0;
    float rt_depth  = has_rt ? compute_depth_01 : 1.0;
    float a         = clamp(gfx_rgba.a, 0.0, 1.0);

    // Fast path 1: ray-traced output is in front of raster or there is no raster.
    if (has_rt) {
        if (!has_raster || gfx_depth_01 > rt_depth) {
            return denoiser_output_color;
        }
        return gfx_rgba.rgb + denoiser_output_color * (1.0 - a);
    }

    // Fast path 2: opaque raster pixel in front of everything.
    if (has_raster && a >= 0.999) {
        return gfx_rgba.rgb;
    }

    // Environment is sky + clouds behind everything.
    vec3 sky_color = apply_screen_clouds(
        compute_sky_with_sun_and_stars(normalize(ray_gen(screen_uv, camera_info.view_proj_mat_inv).direction)),
        screen_uv);

    if (!has_raster) {
        return sky_color;
    }

    return gfx_rgba.rgb + sky_color * (1.0 - a);
}


const float TERRARIUM_VOXELS_PER_CHUNK_AXIS = 256.0;
const float TERRARIUM_VOXEL_WORLD_SIZE = 1.0 / TERRARIUM_VOXELS_PER_CHUNK_AXIS;
const float TERRARIUM_GLASS_THICKNESS_VOXELS = 2.0;
const float TERRARIUM_GLASS_THICKNESS_WORLD =
    TERRARIUM_GLASS_THICKNESS_VOXELS * TERRARIUM_VOXEL_WORLD_SIZE;
const float TERRARIUM_GLASS_CORE_THICKNESS_WORLD = TERRARIUM_GLASS_THICKNESS_WORLD / 3.0;
const float TERRARIUM_PANEL_THICKNESS_VOXELS = 5.0;
const float TERRARIUM_PANEL_THICKNESS_WORLD =
    TERRARIUM_PANEL_THICKNESS_VOXELS * TERRARIUM_VOXEL_WORLD_SIZE;
const float TERRARIUM_GLASS_TOP_PADDING_WORLD = 0.08;
const int TERRARIUM_GLASS_MAX_HITS = 4;
const float TERRARIUM_GLASS_ALPHA = 0.092;
const float TERRARIUM_GLASS_VOXEL_GRID = TERRARIUM_VOXELS_PER_CHUNK_AXIS;
const uint TERRARIUM_GLASS_SSR_MAX_STEPS = 64u;
const float TERRARIUM_GLASS_SSR_MAX_DISTANCE_WORLD = 1.45;
// Compare glass occlusion in ray/world space instead of non-linear depth space.
// A fixed NDC-depth epsilon grows to a large world-space distance near the far plane.
const float TERRARIUM_GLASS_OCCLUSION_EPS_WORLD = TERRARIUM_VOXEL_WORLD_SIZE * 0.25;
const vec2 TERRARIUM_BOX_MIN_XZ = vec2(-TERRARIUM_GLASS_THICKNESS_WORLD);
const vec2 TERRARIUM_BOX_MAX_XZ = vec2(1.0 + TERRARIUM_GLASS_THICKNESS_WORLD);
const float TERRARIUM_FLOOR_Y = 0.0;
const float TERRARIUM_GLASS_TOP_Y = 1.0 + TERRARIUM_GLASS_TOP_PADDING_WORLD;
const vec3 TERRARIUM_GLASS_BOX_MIN =
    vec3(TERRARIUM_BOX_MIN_XZ.x, TERRARIUM_FLOOR_Y, TERRARIUM_BOX_MIN_XZ.y);
const vec3 TERRARIUM_GLASS_BOX_MAX =
    vec3(TERRARIUM_BOX_MAX_XZ.x, TERRARIUM_GLASS_TOP_Y, TERRARIUM_BOX_MAX_XZ.y);
const vec3 TERRARIUM_BASE_BOX_MIN =
    vec3(TERRARIUM_BOX_MIN_XZ.x,
         TERRARIUM_FLOOR_Y - TERRARIUM_PANEL_THICKNESS_WORLD,
         TERRARIUM_BOX_MIN_XZ.y);
const vec3 TERRARIUM_BASE_BOX_MAX =
    vec3(TERRARIUM_BOX_MAX_XZ.x, TERRARIUM_FLOOR_Y, TERRARIUM_BOX_MAX_XZ.y);
const vec3 TERRARIUM_LID_BOX_MIN =
    vec3(TERRARIUM_BOX_MIN_XZ.x, TERRARIUM_GLASS_TOP_Y, TERRARIUM_BOX_MIN_XZ.y);
const vec3 TERRARIUM_LID_BOX_MAX =
    vec3(TERRARIUM_BOX_MAX_XZ.x,
         TERRARIUM_GLASS_TOP_Y + TERRARIUM_PANEL_THICKNESS_WORLD,
         TERRARIUM_BOX_MAX_XZ.y);

struct TerrariumGlassHit {
    bool hit;
    float t;
    vec3 position;
    vec3 normal;
    vec2 face_uv;
};

struct TerrariumPanelHit {
    bool hit;
    float t;
    vec3 position;
    vec3 normal;
    vec3 box_min;
    vec3 box_max;
    float layer;
};

float scene_ray_t_from_depth(vec2 screen_uv, Ray ray, float depth_01) {
    vec4 ndc = vec4(screen_uv * 2.0 - 1.0, depth_01, 1.0);
    vec3 world_pos = ndc_to_world(ndc, camera_info.view_proj_mat_inv);
    return dot(world_pos - ray.origin, ray.direction);
}

float nearest_scene_ray_t(vec2 screen_uv, Ray ray, float gfx_depth_01,
                          float compute_depth_01, vec4 gfx_rgba) {
    float nearest_t = 1e20;
    if (gfx_rgba.a > 0.0 && gfx_depth_01 < 1.0) {
        nearest_t = min(nearest_t, scene_ray_t_from_depth(screen_uv, ray, gfx_depth_01));
    }
    if (compute_depth_01 < 1.0) {
        nearest_t = min(nearest_t, scene_ray_t_from_depth(screen_uv, ray, compute_depth_01));
    }
    return nearest_t;
}

TerrariumPanelHit make_empty_terrarium_panel_hit() {
    TerrariumPanelHit hit;
    hit.hit = false;
    hit.t = 1e20;
    hit.position = vec3(0.0);
    hit.normal = vec3(0.0, 1.0, 0.0);
    hit.box_min = vec3(0.0);
    hit.box_max = vec3(0.0);
    hit.layer = 0.0;
    return hit;
}

vec3 terrarium_box_normal(vec3 position, vec3 box_min, vec3 box_max) {
    const float eps = 1.0e-4;
    if (abs(position.x - box_min.x) < eps) {
        return vec3(-1.0, 0.0, 0.0);
    }
    if (abs(position.x - box_max.x) < eps) {
        return vec3(1.0, 0.0, 0.0);
    }
    if (abs(position.y - box_min.y) < eps) {
        return vec3(0.0, -1.0, 0.0);
    }
    if (abs(position.y - box_max.y) < eps) {
        return vec3(0.0, 1.0, 0.0);
    }
    if (abs(position.z - box_min.z) < eps) {
        return vec3(0.0, 0.0, -1.0);
    }
    return vec3(0.0, 0.0, 1.0);
}

void try_terrarium_panel_box(inout TerrariumPanelHit best_hit, Ray ray, vec3 box_min,
                             vec3 box_max, float layer, float min_t) {
    vec3 t0 = (box_min - ray.origin) * ray.inv_direction;
    vec3 t1 = (box_max - ray.origin) * ray.inv_direction;
    vec3 t_near3 = min(t0, t1);
    vec3 t_far3 = max(t0, t1);
    float t_near = max(max(t_near3.x, t_near3.y), t_near3.z);
    float t_far = min(min(t_far3.x, t_far3.y), t_far3.z);
    if (t_far <= max(t_near, min_t)) {
        return;
    }

    float t = t_near > min_t ? t_near : t_far;
    if (t <= min_t || t >= best_hit.t) {
        return;
    }

    vec3 position = ray.origin + ray.direction * t;
    best_hit.hit = true;
    best_hit.t = t;
    best_hit.position = position;
    best_hit.normal = terrarium_box_normal(position, box_min, box_max);
    best_hit.box_min = box_min;
    best_hit.box_max = box_max;
    best_hit.layer = layer;
}

TerrariumPanelHit trace_terrarium_panels(Ray ray, float min_t) {
    TerrariumPanelHit hit = make_empty_terrarium_panel_hit();
    try_terrarium_panel_box(hit, ray, TERRARIUM_BASE_BOX_MIN, TERRARIUM_BASE_BOX_MAX, 0.0, min_t);
    try_terrarium_panel_box(hit, ray, TERRARIUM_LID_BOX_MIN, TERRARIUM_LID_BOX_MAX, 1.0, min_t);
    return hit;
}

vec3 shade_terrarium_panel_hit(TerrariumPanelHit hit) {
    vec3 normal = normalize(hit.normal);
    vec3 view_dir = normalize(camera_info.pos.xyz - hit.position);
    float ndotv = clamp(dot(normal, view_dir), 0.0, 1.0);
    float sun = max(dot(normal, normalize(sun_info.sun_dir)), 0.0);
    float up_face = step(0.5, normal.y);
    float down_face = step(0.5, -normal.y);
    float side_face = 1.0 - max(up_face, down_face);

    vec3 local = (hit.position - hit.box_min) / max(hit.box_max - hit.box_min, vec3(1.0e-5));
    float x_edge = min(local.x, 1.0 - local.x);
    float z_edge = min(local.z, 1.0 - local.z);
    float y_edge = min(local.y, 1.0 - local.y);
    float rim_width_x = TERRARIUM_PANEL_THICKNESS_WORLD /
                        max(hit.box_max.x - hit.box_min.x, 1.0e-5);
    float rim_width_z = TERRARIUM_PANEL_THICKNESS_WORLD /
                        max(hit.box_max.z - hit.box_min.z, 1.0e-5);
    float rim = max(1.0 - step(rim_width_x, x_edge),
                    1.0 - step(rim_width_z, z_edge));
    float layer_tint = hit.layer;

    vec3 walnut = vec3(0.16, 0.105, 0.055);
    vec3 dark_trim = vec3(0.060, 0.050, 0.038);
    vec3 warm_edge = vec3(0.42, 0.285, 0.125);
    vec3 top_tint = mix(vec3(1.0), vec3(0.86, 0.92, 1.0), layer_tint * 0.18);
    vec3 base_color = mix(walnut, dark_trim, side_face * 0.38 + down_face * 0.30) * top_tint;
    base_color = mix(base_color, warm_edge * top_tint, rim * (0.36 + up_face * 0.18));

    vec3 grain_cell = floor(hit.position * (TERRARIUM_VOXELS_PER_CHUNK_AXIS / 4.0));
    float grain = hash13(grain_cell + vec3(19.0, 47.0, hit.layer * 83.0));
    base_color *= 0.96 + grain * 0.04;
    base_color *= 0.55 + sun * 0.32 + ndotv * 0.14 + up_face * 0.08 - down_face * 0.10;
    base_color += warm_edge * rim * side_face * (1.0 - step(0.18, y_edge)) * 0.10;
    return max(base_color, vec3(0.0));
}

vec3 apply_terrarium_panels_to_scene(vec3 scene_color, Ray ray, float scene_t) {
    TerrariumPanelHit panel_hit = trace_terrarium_panels(ray, 0.0);
    if (panel_hit.hit && panel_hit.t + TERRARIUM_GLASS_OCCLUSION_EPS_WORLD < scene_t) {
        return shade_terrarium_panel_hit(panel_hit);
    }
    return scene_color;
}

vec3 sample_scene_color(vec2 screen_uv) {
    ivec2 img_size = imageSize(composited_tex);
    vec2 clamped_uv = clamp(screen_uv, vec2(0.0), vec2(1.0));
    ivec2 sample_uvi = ivec2(
        clamp(clamped_uv * vec2(img_size), vec2(0.0), vec2(img_size - ivec2(1))));

    float gfx_depth_01 = texelFetch(gfx_depth_tex, sample_uvi, 0).r;
    float compute_depth_01 = imageLoad(compute_depth_tex, sample_uvi).r;
    vec4 gfx_rgba = texelFetch(gfx_output_tex, sample_uvi, 0);
    vec3 denoised_color = imageLoad(denoiser_spatial_pong_tex, sample_uvi).rgb;
    vec3 scene_color = combine_colors(gfx_depth_01, compute_depth_01, gfx_rgba,
                                      denoised_color, clamped_uv);
    Ray ray = ray_gen(clamped_uv, camera_info.view_proj_mat_inv);
    float scene_t = nearest_scene_ray_t(clamped_uv, ray, gfx_depth_01, compute_depth_01, gfx_rgba);
    return apply_terrarium_panels_to_scene(scene_color, ray, scene_t);
}

void accumulate_raster_reflection_tap(inout vec3 color_sum, inout float weight_sum,
                                       vec2 sample_uv, ivec2 tex_size, float weight) {
    ivec2 sample_uvi = ivec2(
        clamp(sample_uv * vec2(tex_size), vec2(0.0), vec2(tex_size - ivec2(1))));
    vec4 raster_rgba = texelFetch(gfx_output_tex, sample_uvi, 0);
    if (raster_rgba.a <= 0.02) {
        return;
    }

    float tap_weight = weight * clamp(raster_rgba.a, 0.0, 1.0);
    color_sum += (raster_rgba.rgb / max(raster_rgba.a, 0.08)) * tap_weight;
    weight_sum += tap_weight;
}

vec3 sample_raster_reflection_footprint(vec2 sample_uv, ivec2 tex_size, vec4 center_rgba) {
    vec2 texel = 1.0 / vec2(tex_size);
    float footprint_pixels = max(gui_input.glass_ssr_footprint_pixels, 0.0);
    vec2 radius = texel * footprint_pixels;
    vec3 color_sum = vec3(0.0);
    float weight_sum = 0.0;

    accumulate_raster_reflection_tap(color_sum, weight_sum, sample_uv, tex_size, 1.00);
    accumulate_raster_reflection_tap(color_sum, weight_sum, sample_uv + vec2(radius.x, 0.0),
                                     tex_size, 0.55);
    accumulate_raster_reflection_tap(color_sum, weight_sum, sample_uv - vec2(radius.x, 0.0),
                                     tex_size, 0.55);
    accumulate_raster_reflection_tap(color_sum, weight_sum, sample_uv + vec2(0.0, radius.y),
                                     tex_size, 0.55);
    accumulate_raster_reflection_tap(color_sum, weight_sum, sample_uv - vec2(0.0, radius.y),
                                     tex_size, 0.55);

    if (weight_sum > 0.0) {
        return color_sum / weight_sum;
    }
    return center_rgba.rgb / max(center_rgba.a, 0.08);
}

float sample_raster_ssr_reflection(vec3 origin_ws, vec3 direction_ws, float jitter_seed,
                                   out vec3 reflection_color) {
    reflection_color = vec3(0.0);
    vec3 ray_dir = normalize(direction_ws);
    uint step_count = clamp(gui_input.glass_ssr_steps, 1u, TERRARIUM_GLASS_SSR_MAX_STEPS);
    float step_len = TERRARIUM_GLASS_SSR_MAX_DISTANCE_WORLD / float(step_count);
    float min_hit_thickness_world = max(gui_input.glass_ssr_min_hit_thickness_voxels, 0.0) *
                                    TERRARIUM_VOXEL_WORLD_SIZE;
    float jitter = (jitter_seed - 0.5) * step_len * 0.45;
    ivec2 tex_size = textureSize(gfx_output_tex, 0);
    bool have_prev_depth_sample = false;
    float prev_depth_gap = 0.0;
    float prev_t = 0.0;
    vec2 prev_uv = vec2(0.0);

    for (uint i = 0u; i < TERRARIUM_GLASS_SSR_MAX_STEPS; i++) {
        if (i >= step_count) {
            break;
        }
        float t = (float(i) + 0.65) * step_len + jitter;
        if (t <= 0.0) {
            continue;
        }

        vec3 probe_ws = origin_ws + ray_dir * t;
        vec4 clip = camera_info.view_proj_mat * vec4(probe_ws, 1.0);
        if (clip.w <= 0.0) {
            have_prev_depth_sample = false;
            continue;
        }

        vec3 ndc = clip.xyz / clip.w;
        if (ndc.z <= 0.0 || ndc.z >= 1.0) {
            have_prev_depth_sample = false;
            continue;
        }

        vec2 sample_uv = ndc.xy * 0.5 + 0.5;
        if (any(lessThan(sample_uv, vec2(0.0))) || any(greaterThan(sample_uv, vec2(1.0)))) {
            have_prev_depth_sample = false;
            continue;
        }

        ivec2 sample_uvi = ivec2(
            clamp(sample_uv * vec2(tex_size), vec2(0.0), vec2(tex_size - ivec2(1))));
        float raster_depth = texelFetch(gfx_depth_tex, sample_uvi, 0).r;
        vec4 raster_rgba = texelFetch(gfx_output_tex, sample_uvi, 0);
        if (raster_depth >= 1.0 || raster_rgba.a <= 0.02) {
            have_prev_depth_sample = false;
            continue;
        }

        // Treat min-hit-thickness as a camera-depth tolerance only. The previous
        // ray-cylinder test expanded sideways in world space, so large values could
        // accept nearby but different raster silhouettes and show ghost reflections.
        Ray camera_ray = ray_gen(sample_uv, camera_info.view_proj_mat_inv);
        float scene_camera_t = scene_ray_t_from_depth(sample_uv, camera_ray, raster_depth);
        float probe_camera_t = dot(probe_ws - camera_ray.origin, camera_ray.direction);
        float depth_gap = probe_camera_t - scene_camera_t;
        float hit_thickness = max(min_hit_thickness_world, 1e-5) + t * 0.028;
        bool crosses_depth = have_prev_depth_sample && prev_depth_gap < 0.0 && depth_gap >= 0.0;
        bool inside_depth_slab = depth_gap >= 0.0 && depth_gap <= hit_thickness;
        if (!crosses_depth && !inside_depth_slab) {
            have_prev_depth_sample = true;
            prev_depth_gap = depth_gap;
            prev_t = t;
            prev_uv = sample_uv;
            continue;
        }

        vec2 hit_uv = sample_uv;
        float hit_t = t;
        vec4 hit_rgba = raster_rgba;
        float depth_fade = 1.0 - clamp(depth_gap / hit_thickness, 0.0, 1.0);
        if (crosses_depth) {
            float cross_alpha = clamp((-prev_depth_gap) / max(depth_gap - prev_depth_gap, 1e-5),
                                      0.0, 1.0);
            hit_uv = mix(prev_uv, sample_uv, cross_alpha);
            hit_t = mix(prev_t, t, cross_alpha);
            ivec2 hit_uvi = ivec2(
                clamp(hit_uv * vec2(tex_size), vec2(0.0), vec2(tex_size - ivec2(1))));
            hit_rgba = texelFetch(gfx_output_tex, hit_uvi, 0);
            if (hit_rgba.a <= 0.02) {
                have_prev_depth_sample = true;
                prev_depth_gap = depth_gap;
                prev_t = t;
                prev_uv = sample_uv;
                continue;
            }
            depth_fade = 1.0;
        }

        float screen_edge = min(min(hit_uv.x, 1.0 - hit_uv.x),
                                min(hit_uv.y, 1.0 - hit_uv.y));
        float screen_fade = smoothstep(0.02, 0.14, screen_edge);
        float distance_fade = 1.0 -
                              smoothstep(TERRARIUM_GLASS_SSR_MAX_DISTANCE_WORLD * 0.72,
                                         TERRARIUM_GLASS_SSR_MAX_DISTANCE_WORLD, hit_t);
        float confidence = screen_fade * distance_fade * depth_fade *
                           clamp(hit_rgba.a, 0.0, 1.0);
        reflection_color = sample_raster_reflection_footprint(hit_uv, tex_size, hit_rgba);
        return confidence;
    }

    return 0.0;
}

TerrariumGlassHit make_empty_terrarium_glass_hit() {
    TerrariumGlassHit hit;
    hit.hit = false;
    hit.t = 1e20;
    hit.position = vec3(0.0);
    hit.normal = vec3(0.0, 0.0, 1.0);
    hit.face_uv = vec2(0.0);
    return hit;
}

void store_terrarium_glass_hit(inout TerrariumGlassHit best_hit, float t, vec3 position,
                                vec3 normal, vec2 face_uv) {
    vec4 clip = camera_info.view_proj_mat * vec4(position, 1.0);
    if (clip.w <= 0.0) {
        return;
    }

    best_hit.hit = true;
    best_hit.t = t;
    best_hit.position = position;
    best_hit.normal = normal;
    best_hit.face_uv = clamp(face_uv, vec2(0.0), vec2(1.0));
}

void try_vertical_glass_face(inout TerrariumGlassHit best_hit, Ray ray, vec3 normal,
                             float plane_coord, int axis, float min_t) {
    float denom = axis == 0 ? ray.direction.x : ray.direction.z;
    if (abs(denom) < 1e-5) {
        return;
    }

    float origin_coord = axis == 0 ? ray.origin.x : ray.origin.z;
    float t = (plane_coord - origin_coord) / denom;
    if (t <= min_t || t >= best_hit.t) {
        return;
    }

    vec3 position = ray.origin + ray.direction * t;
    if (position.y < TERRARIUM_GLASS_BOX_MIN.y || position.y > TERRARIUM_GLASS_BOX_MAX.y) {
        return;
    }

    vec2 face_uv;
    if (axis == 0) {
        if (position.z < TERRARIUM_GLASS_BOX_MIN.z || position.z > TERRARIUM_GLASS_BOX_MAX.z) {
            return;
        }
        face_uv = vec2(
            (position.z - TERRARIUM_GLASS_BOX_MIN.z) /
                (TERRARIUM_GLASS_BOX_MAX.z - TERRARIUM_GLASS_BOX_MIN.z),
            (position.y - TERRARIUM_GLASS_BOX_MIN.y) /
                (TERRARIUM_GLASS_BOX_MAX.y - TERRARIUM_GLASS_BOX_MIN.y));
    } else {
        if (position.x < TERRARIUM_GLASS_BOX_MIN.x || position.x > TERRARIUM_GLASS_BOX_MAX.x) {
            return;
        }
        face_uv = vec2(
            (position.x - TERRARIUM_GLASS_BOX_MIN.x) /
                (TERRARIUM_GLASS_BOX_MAX.x - TERRARIUM_GLASS_BOX_MIN.x),
            (position.y - TERRARIUM_GLASS_BOX_MIN.y) /
                (TERRARIUM_GLASS_BOX_MAX.y - TERRARIUM_GLASS_BOX_MIN.y));
    }

    store_terrarium_glass_hit(best_hit, t, position, normal, face_uv);
}

TerrariumGlassHit trace_terrarium_glass_after(Ray ray, float min_t) {
    TerrariumGlassHit hit = make_empty_terrarium_glass_hit();

    try_vertical_glass_face(hit, ray, vec3(-1.0, 0.0, 0.0), TERRARIUM_GLASS_BOX_MIN.x, 0, min_t);
    try_vertical_glass_face(hit, ray, vec3(1.0, 0.0, 0.0), TERRARIUM_GLASS_BOX_MAX.x, 0, min_t);
    try_vertical_glass_face(hit, ray, vec3(0.0, 0.0, -1.0), TERRARIUM_GLASS_BOX_MIN.z, 1, min_t);
    try_vertical_glass_face(hit, ray, vec3(0.0, 0.0, 1.0), TERRARIUM_GLASS_BOX_MAX.z, 1, min_t);

    return hit;
}

vec3 shade_terrarium_glass_hit(vec3 scene_color, vec2 screen_uv, Ray ray,
                                TerrariumGlassHit hit) {
    vec3 view_dir = normalize(-ray.direction);
    vec3 normal = hit.normal;
    if (dot(normal, view_dir) < 0.0) {
        normal = -normal;
    }

    // Only shade the inner side of each pane. Rays crossing a pane from outside to inside
    // see air, while rays crossing from inside to outside see glass. This hides the two
    // camera-facing outside panes without depending on camera distance or box containment.
    if (dot(ray.direction, hit.normal) <= 0.0) {
        return scene_color;
    }

    vec3 configured_glass_tint = clamp(gui_input.glass_tint, vec3(0.0), vec3(1.5));
    float glass_reflection_strength = max(gui_input.glass_reflection_strength, 0.0);
    float glass_ssr_strength = max(gui_input.glass_ssr_strength, 0.0);
    float glass_refraction_strength = max(gui_input.glass_refraction_strength, 0.0);
    float glass_alpha_multiplier = max(gui_input.glass_alpha, 0.0);
    float glass_glint_strength = max(gui_input.glass_glint_strength, 0.0);

    vec2 uv = hit.face_uv;
    vec2 face_world_extent = abs(hit.normal.y) > 0.5
                                 ? vec2(TERRARIUM_GLASS_BOX_MAX.x - TERRARIUM_GLASS_BOX_MIN.x,
                                        TERRARIUM_GLASS_BOX_MAX.z - TERRARIUM_GLASS_BOX_MIN.z)
                                 : (abs(hit.normal.x) > 0.5
                                        ? vec2(TERRARIUM_GLASS_BOX_MAX.z - TERRARIUM_GLASS_BOX_MIN.z,
                                               TERRARIUM_GLASS_BOX_MAX.y - TERRARIUM_GLASS_BOX_MIN.y)
                                        : vec2(TERRARIUM_GLASS_BOX_MAX.x - TERRARIUM_GLASS_BOX_MIN.x,
                                               TERRARIUM_GLASS_BOX_MAX.y - TERRARIUM_GLASS_BOX_MIN.y));
    vec2 edge_width = TERRARIUM_GLASS_THICKNESS_WORLD / face_world_extent;
    vec2 core_width = TERRARIUM_GLASS_CORE_THICKNESS_WORLD / face_world_extent;
    float left_edge = 1.0 - step(edge_width.x, uv.x);
    float right_edge = step(1.0 - edge_width.x, uv.x);
    float bottom_edge = 1.0 - step(edge_width.y, uv.y);
    float top_edge = step(1.0 - edge_width.y, uv.y);
    float edge = max(max(left_edge, right_edge), max(bottom_edge, top_edge));
    float pane = 1.0 - edge;

    float core_left_edge = 1.0 - step(core_width.x, uv.x);
    float core_right_edge = step(1.0 - core_width.x, uv.x);
    float core_bottom_edge = 1.0 - step(core_width.y, uv.y);
    float core_top_edge = step(1.0 - core_width.y, uv.y);
    float core_edge = max(max(core_left_edge, core_right_edge),
                          max(core_bottom_edge, core_top_edge));
    float corner = max(left_edge, right_edge) * max(top_edge, bottom_edge);

    vec2 voxel_grid_extent = face_world_extent * TERRARIUM_GLASS_VOXEL_GRID;
    vec2 voxel_pos = uv * voxel_grid_extent;
    vec2 voxel_cell = floor(voxel_pos);
    vec2 voxel_uv = fract(voxel_pos);
    vec2 voxel_center_offset = voxel_uv - vec2(0.5);
    float cell_noise = hash13(vec3(voxel_cell, dot(abs(hit.normal), vec3(3.0, 17.0, 41.0))));
    float cell_noise_b = hash13(vec3(voxel_cell.yx + vec2(29.0, 11.0),
                                     dot(abs(hit.normal), vec3(53.0, 7.0, 23.0))));
    float cell_noise_c = hash13(vec3(voxel_cell + vec2(5.0, 31.0), 71.0));
    float voxel_lens = dot(voxel_center_offset, voxel_center_offset) * pane;
    vec2 voxel_slope = voxel_center_offset * (0.45 + cell_noise_c * 0.22);
    vec3 face_tangent = abs(hit.normal.x) > 0.5 ? vec3(0.0, 0.0, 1.0) : vec3(1.0, 0.0, 0.0);
    vec3 face_bitangent = vec3(0.0, 1.0, 0.0);
    vec3 micro_normal = normalize(normal + face_tangent * ((cell_noise - 0.5) * 0.050 +
                                                           voxel_slope.x * 0.030) +
                                  face_bitangent * ((cell_noise_b - 0.5) * 0.040 +
                                                    voxel_slope.y * 0.026));
    float mirror_fresnel = pow(1.0 - clamp(dot(normal, view_dir), 0.0, 1.0), 5.0);

    float ndotv = clamp(dot(micro_normal, view_dir), 0.0, 1.0);
    float fresnel = pow(1.0 - ndotv, 5.0);
    float fresnel_band = step(0.42, fresnel);

    vec3 entry_normal = dot(ray.direction, hit.normal) < 0.0 ? micro_normal : -micro_normal;
    float eta = dot(ray.direction, hit.normal) < 0.0 ? (1.0 / 1.45) : 1.45;
    vec3 physical_refracted_dir = refract(ray.direction, entry_normal, eta);
    if (dot(physical_refracted_dir, physical_refracted_dir) < 1e-5) {
        physical_refracted_dir = ray.direction;
    }
    vec2 physical_refraction_uv = project_world_to_screen(
        hit.position + physical_refracted_dir * (0.20 + edge * 0.24 + core_edge * 0.12 +
                                                 voxel_lens * 0.018),
        camera_info.view_proj_mat);
    vec2 physical_offset = clamp(physical_refraction_uv - screen_uv, vec2(-0.027), vec2(0.027)) *
                           glass_refraction_strength;

    vec3 normal_vs3 = normalize((camera_info.view_mat * vec4(micro_normal, 0.0)).xyz);
    vec2 normal_vs = normal_vs3.xy;
    vec2 uv_edge_push = vec2(left_edge - right_edge, bottom_edge - top_edge);
    vec2 refract_dir = normal_vs * 0.70 + uv_edge_push * 0.50 + voxel_slope * pane * 0.11;
    if (dot(refract_dir, refract_dir) < 1e-5) {
        refract_dir = edge > 0.0 ? vec2(0.0, -1.0) : vec2(0.0);
    } else {
        refract_dir = normalize(refract_dir);
    }

    float pane_distortion = pane * (0.00075 + fresnel_band * 0.00055 + cell_noise * 0.00048 +
                                    voxel_lens * 0.00055);
    float edge_distortion = edge * (0.0090 + core_edge * 0.0045 + corner * 0.0040 +
                                    fresnel_band * 0.0025);
    float distortion = (pane_distortion + edge_distortion) * glass_refraction_strength;
    vec2 refraction_offset = pane * physical_offset * (0.17 + voxel_lens * 0.035) +
                             edge * physical_offset * 0.62 + refract_dir * distortion;
    vec2 refracted_uv = clamp(screen_uv + refraction_offset, vec2(0.0), vec2(1.0));
    vec3 refracted_color = sample_scene_color(refracted_uv);

    vec2 chroma_dir = refract_dir;
    if (dot(chroma_dir, chroma_dir) < 1e-5 && dot(physical_offset, physical_offset) > 1e-7) {
        chroma_dir = normalize(physical_offset);
    }
    float chroma = (pane * (0.00012 + fresnel_band * 0.00006 + voxel_lens * 0.00006) +
                    edge * (0.00080 + core_edge * 0.00120 + corner * 0.00100 +
                            fresnel_band * 0.00070)) *
                   glass_refraction_strength;
    vec3 chromatic_color;
    chromatic_color.r = sample_scene_color(screen_uv + refraction_offset +
                                           chroma_dir * chroma).r;
    chromatic_color.g = refracted_color.g;
    chromatic_color.b = sample_scene_color(screen_uv + refraction_offset -
                                           chroma_dir * chroma).b;

    float body_alpha = TERRARIUM_GLASS_ALPHA;
    float refraction_mix = pane * clamp(0.095 + fresnel_band * 0.040 + voxel_lens * 0.020,
                                        0.0, 0.19) +
                           edge * clamp(0.58 + core_edge * 0.16 + corner * 0.12 +
                                        fresnel_band * 0.08, 0.0, 0.92);
    refraction_mix = clamp(refraction_mix * glass_refraction_strength, 0.0, 0.98);
    vec3 glassed_color = mix(scene_color, chromatic_color, refraction_mix);

    // Keep reflection perfectly planar: trace from the exact glass hit position with the
    // geometric face normal, rather than snapping the ray to a per-voxel pane cell.
    vec3 reflected_dir = reflect(-view_dir, normal);
    vec3 sky_reflection = compute_sky_with_sun_and_stars(reflected_dir);
    vec3 ssr_reflection = sky_reflection;
    vec2 reflection_pixel = screen_uv * vec2(imageSize(composited_tex));
    float ssr_jitter_seed = hash13(vec3(reflection_pixel, 17.0));
    float ssr_hit = sample_raster_ssr_reflection(
        hit.position + reflected_dir * (TERRARIUM_VOXEL_WORLD_SIZE * 2.0),
        reflected_dir,
        ssr_jitter_seed,
        ssr_reflection);
    vec3 reflection_color = mix(sky_reflection, ssr_reflection,
                                clamp(ssr_hit * 0.86 * glass_ssr_strength, 0.0, 1.0));
    glassed_color = mix(glassed_color, ssr_reflection,
                        clamp(ssr_hit * pane * 0.10 * glass_ssr_strength *
                                  glass_reflection_strength,
                              0.0, 1.0));
    float sun_glint = pow(max(dot(reflected_dir, normalize(sun_info.sun_dir)), 0.0), 180.0);
    sun_glint *= clamp(sun_info.sun_display_luminance, 0.0, 2.0);

    vec3 cool_tint = vec3(0.68, 0.95, 1.00);
    vec3 aqua_tint = vec3(0.50, 1.00, 0.90);
    vec3 violet_tint = vec3(0.88, 0.80, 1.00);
    vec3 amber_tint = vec3(1.00, 0.92, 0.62);
    vec3 pane_color = mix(cool_tint, aqua_tint, cell_noise * 0.35);
    pane_color = mix(pane_color, violet_tint, cell_noise_b * 0.18);
    pane_color = mix(pane_color, amber_tint, top_edge * 0.22 + cell_noise_c * 0.035);
    vec3 side_edge_color = vec3(0.54, 0.96, 0.92);
    vec3 top_edge_color = vec3(1.00, 0.94, 0.74);
    vec3 bottom_edge_color = vec3(0.55, 0.74, 1.00);
    vec3 edge_color = mix(side_edge_color, top_edge_color, top_edge * 0.45);
    edge_color = mix(edge_color, bottom_edge_color, bottom_edge * 0.35);

    vec3 glass_color = mix(pane_color, edge_color, edge);
    vec3 glass_tint = configured_glass_tint;
    glassed_color = mix(glassed_color, glassed_color * glass_tint, 0.18);
    glass_color = mix(glass_color, glass_tint, 0.28);
    glass_color += reflection_color * glass_reflection_strength *
                   (edge * 0.14 + core_edge * 0.08 + fresnel_band * 0.035 +
                    pane * (0.018 + mirror_fresnel * 0.020 +
                            ssr_hit * glass_ssr_strength * 0.070));
    glass_color += ssr_reflection * ssr_hit * glass_ssr_strength *
                   glass_reflection_strength *
                   (pane * (0.12 + mirror_fresnel * 0.08) + edge * 0.08);
    glass_color += sun_info.sun_color * sun_glint * glass_glint_strength *
                   (edge * 0.58 + core_edge * 0.32 + pane * 0.050);

    float pane_alpha = pane * (body_alpha + fresnel_band * 0.012 + voxel_lens * 0.006);
    float edge_alpha = edge * (0.145 + core_edge * 0.090 + corner * 0.070 +
                               fresnel_band * 0.030);
    float alpha = clamp((pane_alpha + edge_alpha) * glass_alpha_multiplier, 0.0, 0.46);
    vec3 shaded_glass = mix(glassed_color, glass_color, alpha);
    return shaded_glass;
}

vec3 apply_terrarium_glass(vec3 scene_color, vec2 screen_uv, Ray ray, float scene_t) {
    TerrariumGlassHit hits[TERRARIUM_GLASS_MAX_HITS];
    int hit_count = 0;
    float min_t = 0.0;
    for (int i = 0; i < TERRARIUM_GLASS_MAX_HITS; i++) {
        TerrariumGlassHit hit = trace_terrarium_glass_after(ray, min_t);
        if (!hit.hit) {
            break;
        }
        hits[hit_count] = hit;
        hit_count++;
        min_t = hit.t + 0.0001;
    }

    vec3 result = scene_color;
    for (int i = hit_count - 1; i >= 0; i--) {
        TerrariumGlassHit hit = hits[i];
        // If opaque scene geometry reaches this pixel before the glass plane along the
        // same camera ray, the glass is physically hidden by that geometry.
        if (scene_t + TERRARIUM_GLASS_OCCLUSION_EPS_WORLD < hit.t) {
            continue;
        }
        result = shade_terrarium_glass_hit(result, screen_uv, ray, hit);
    }
    return result;
}

vec3 sample_lens_flare(vec2 screen_uv) {
    ivec2 lens_flare_size = imageSize(lens_flare_output_tex);
    ivec2 lens_flare_uvi  = ivec2(
        clamp(screen_uv * vec2(lens_flare_size), vec2(0.0), vec2(lens_flare_size - ivec2(1))));
    return imageLoad(lens_flare_output_tex, lens_flare_uvi).rgb;
}

void main() {
    ivec2 uvi = ivec2(gl_GlobalInvocationID.xy);
    if (any(greaterThanEqual(uvi, imageSize(composited_tex)))) {
        return;
    }

    vec2 img_size  = vec2(imageSize(composited_tex));
    vec2 screen_uv = (vec2(gl_GlobalInvocationID.xy) + vec2(0.5)) / img_size;

    float gfx_depth_01     = texelFetch(gfx_depth_tex, uvi, 0).r;
    float compute_depth_01 = imageLoad(compute_depth_tex, uvi).r;

    vec4 gfx_rgba                  = texelFetch(gfx_output_tex, uvi, 0);
    vec3 denoiser_spatial_pong_tex = imageLoad(denoiser_spatial_pong_tex, uvi).rgb;
    vec3 final_color               = combine_colors(gfx_depth_01, compute_depth_01, gfx_rgba,
                                                    denoiser_spatial_pong_tex, screen_uv);
    Ray ray = ray_gen(screen_uv, camera_info.view_proj_mat_inv);
    float scene_t = nearest_scene_ray_t(screen_uv, ray, gfx_depth_01, compute_depth_01, gfx_rgba);
    TerrariumPanelHit panel_hit = trace_terrarium_panels(ray, 0.0);
    if (panel_hit.hit && panel_hit.t + TERRARIUM_GLASS_OCCLUSION_EPS_WORLD < scene_t) {
        final_color = shade_terrarium_panel_hit(panel_hit);
        scene_t = panel_hit.t;
    }
    final_color = apply_terrarium_glass(final_color, screen_uv, ray, scene_t);
    final_color += sample_lens_flare(screen_uv);

    float sun_visibility = sun_luminance_from_dir(sun_info.sun_dir, 1.0);
    float god_ray_weight = imageLoad(god_ray_output_tex, uvi).r * god_ray_info.weight;
    god_ray_weight *= sun_visibility;
    vec3 god_ray_color_rgb = srgb_to_linear(god_ray_info.color);
    vec4 god_ray_color     = vec4(god_ray_color_rgb, god_ray_weight);
    final_color            = mix(final_color, god_ray_color.rgb, god_ray_color.a);

    imageStore(composited_tex, uvi, vec4(final_color, 1.0));
}
