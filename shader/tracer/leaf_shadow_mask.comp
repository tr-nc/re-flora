#version 450

#extension GL_GOOGLE_include_directive : require

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(set = 0, binding = 0) uniform sampler2D leaf_shadow_opacity_tex;
layout(set = 0, binding = 1, rgba8) writeonly uniform image2D leaf_shadow_mask_tex;

const float LEAF_SHADOW_MASK_THRESHOLD = 0.003;

void main() {
    ivec2 uvi = ivec2(gl_GlobalInvocationID.xy);
    ivec2 mask_size = imageSize(leaf_shadow_mask_tex);
    if (any(greaterThanEqual(uvi, mask_size))) {
        return;
    }

    // Build a conservative low-resolution influence mask by looking at the
    // current mask cell and its neighbors. The neighboring cells dilate the
    // mask enough that high-res receiver sampling can be skipped safely while
    // wind moves leaf silhouettes between low-res texels.
    float max_opacity = 0.0;
    for (int dy = -1; dy <= 1; ++dy) {
        for (int dx = -1; dx <= 1; ++dx) {
            ivec2 cell = clamp(uvi + ivec2(dx, dy), ivec2(0), mask_size - ivec2(1));
            for (int sy = 0; sy < 2; ++sy) {
                for (int sx = 0; sx < 2; ++sx) {
                    vec2 subcell = vec2(0.25 + 0.5 * float(sx), 0.25 + 0.5 * float(sy));
                    vec2 uv = (vec2(cell) + subcell) / vec2(mask_size);
                    max_opacity = max(max_opacity, textureLod(leaf_shadow_opacity_tex, uv, 0.0).a);
                }
            }
        }
    }

    float mask = max_opacity > LEAF_SHADOW_MASK_THRESHOLD ? 1.0 : 0.0;
    imageStore(leaf_shadow_mask_tex, uvi, vec4(0.0, 0.0, 0.0, mask));
}
