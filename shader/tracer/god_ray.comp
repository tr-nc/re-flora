#version 460

#extension GL_GOOGLE_include_directive : require

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(set = 0, binding = 0) uniform U_CameraInfo {
    vec4 pos;
    mat4 view_mat;
    mat4 view_mat_inv;
    mat4 proj_mat;
    mat4 proj_mat_inv;
    mat4 view_proj_mat;
    mat4 view_proj_mat_inv;
}
camera_info;
layout(set = 0, binding = 1) uniform U_ShadowCameraInfo {
    vec4 pos;
    mat4 view_mat;
    mat4 view_mat_inv;
    mat4 proj_mat;
    mat4 proj_mat_inv;
    mat4 view_proj_mat;
    mat4 view_proj_mat_inv;
}
shadow_camera_info;
layout(set = 0, binding = 2) uniform U_EnvInfo { uint frame_serial_idx; }
env_info;
layout(set = 0, binding = 3) uniform U_GodRayInfo {
    float max_depth;
    uint max_checks;
    float weight;
    vec3 color;
}
god_ray_info;
layout(set = 0, binding = 4) uniform sampler2D gfx_depth_tex;
layout(set = 0, binding = 5, r32f) uniform readonly image2D compute_depth_tex;
layout(set = 0, binding = 6) uniform sampler2D shadow_map_tex;
layout(set = 0, binding = 7, r32f) uniform writeonly image2D god_ray_output_tex;
#define GUI_INPUT_BINDING 8
#include "../include/gui_input.glsl"

layout(set = 1, binding = 0) uniform sampler2DArray scalar_bn;
layout(set = 1, binding = 1) uniform sampler2DArray unit_vec2_bn;
layout(set = 1, binding = 2) uniform sampler2DArray unit_vec3_bn;
layout(set = 1, binding = 3) uniform sampler2DArray weighted_cosine_bn;
layout(set = 1, binding = 4) uniform sampler2DArray fast_unit_vec3_bn;
layout(set = 1, binding = 5) uniform sampler2DArray fast_weighted_cosine_bn;
#include "../include/noise_tex.glsl"

#include "../include/ocean_depth.glsl"
#include "../include/ray.glsl"

bool estimate_ocean_near_depth(vec3 view_dir, out float ocean_near_depth_01) {
    ocean_near_depth_01 = 1.0;

    vec3 ori        = camera_info.pos.xyz;
    vec3 dir        = normalize(view_dir);
    float sea_level = ocean_depth_sea_level();

    if (dir.y >= 0.0) {
        return false;
    }

    vec3 water_plane_high = vec3(0.0, sea_level, 0.0);
    vec3 water_plane_low  = vec3(0.0, sea_level - OCEAN_DEPTH_WATER_DEPTH, 0.0);
    vec3 up               = vec3(0.0, 1.0, 0.0);

    float high_t = ocean_depth_intersect_plane(ori, dir, water_plane_high, up);
    float low_t  = ocean_depth_intersect_plane(ori, dir, water_plane_low, up);

    if (high_t <= 0.0 || low_t <= 0.0 || low_t <= high_t) {
        return false;
    }

    vec3 high_pos  = ori + dir * high_t;
    vec4 point_ndc = camera_info.view_proj_mat * vec4(high_pos, 1.0);
    ocean_near_depth_01 = point_ndc.z / point_ndc.w;
    return true;
}

float get_depth_01(ivec2 uvi, vec3 view_dir) {
    float gfx_depth_01     = texelFetch(gfx_depth_tex, uvi, 0).r;
    float compute_depth_01 = imageLoad(compute_depth_tex, uvi).r;
    float scene_depth_01   = min(gfx_depth_01, compute_depth_01);

    float ocean_near_depth_01;
    bool may_hit_ocean = estimate_ocean_near_depth(view_dir, ocean_near_depth_01);

    // If scene geometry is in front of the nearest possible ocean surface, the
    // expensive animated ocean raymarch cannot affect the integration length.
    if (!may_hit_ocean || scene_depth_01 <= ocean_near_depth_01) {
        return scene_depth_01;
    }

    bool hit_ocean       = false;
    float ocean_depth_01 = ocean_depth_01_from_view_dir(view_dir, hit_ocean);
    return min(scene_depth_01, ocean_depth_01);
}

void main() {
    ivec2 uvi      = ivec2(gl_GlobalInvocationID.xy);
    ivec2 img_size = textureSize(gfx_depth_tex, 0);
    if (any(greaterThanEqual(uvi, img_size))) {
        return;
    }

    vec2 screen_uv = (vec2(uvi) + vec2(0.5)) / vec2(img_size);
    Ray ray        = ray_gen(screen_uv, camera_info.view_proj_mat_inv);
    float depth_01 = get_depth_01(uvi, ray.direction);

    vec4 near_point_ndc = vec4(screen_uv * 2.0 - 1.0, 0.0, 1.0);
    vec3 near_point_ws  = ndc_to_world(near_point_ndc, camera_info.view_proj_mat_inv);

    vec4 hit_far_point_ndc = vec4(screen_uv * 2.0 - 1.0, depth_01, 1.0);
    vec3 hit_far_point_ws  = ndc_to_world(hit_far_point_ndc, camera_info.view_proj_mat_inv);

    float real_depth = length(hit_far_point_ws - near_point_ws);

    float using_depth = min(real_depth, god_ray_info.max_depth);

    // dynamic step size: adapt to actual depth
    float step_size = using_depth / float(god_ray_info.max_checks);

    ivec3 seed         = get_seed(env_info.frame_serial_idx);
    float random_float = random_float_bn(seed);

    // accumulate lit length along the ray (Riemann sum)
    float shadow_visibility = 0.0;

    for (uint i = 0; i < god_ray_info.max_checks; ++i) {
        float current_depth = (random_float + float(i)) * step_size;
        if (current_depth >= using_depth) break; // past the hit

        vec4 lookup_pos = vec4(ray.origin + ray.direction * current_depth, 1.0);

        vec4 light_space       = shadow_camera_info.view_proj_mat * lookup_pos;
        vec3 ndc               = light_space.xyz / light_space.w;
        vec2 uv                = ndc.xy * 0.5 + 0.5;
        float t                = ndc.z;
        float shadow_tex_depth = texture(shadow_map_tex, uv).r;

        // if the current point in the atmosphere can be lit
        if (shadow_tex_depth > t) {
            float mist_weight = exp(-lookup_pos.y * 2.0);
            shadow_visibility += mist_weight * step_size; // weight by segment length
        }
    }

    imageStore(god_ray_output_tex, uvi, vec4(shadow_visibility, 0.0, 0.0, 1.0));
}
