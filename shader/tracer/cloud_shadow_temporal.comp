#version 460

#extension GL_GOOGLE_include_directive : require

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(push_constant) uniform PC {
    uint reset_history;
}
cloud_shadow_temporal_push;

#include "../include/gui_input.glsl"

layout(set = 0, binding = 6) uniform sampler2D cloud_shadow_raw_tex;
layout(set = 0, binding = 7) uniform sampler2D cloud_shadow_history_tex;
layout(set = 0, binding = 8, r16f) uniform writeonly image2D cloud_shadow_tex;

float current_min_3x3(ivec2 uvi, ivec2 size) {
    float v = texelFetch(cloud_shadow_raw_tex, uvi, 0).r;
    for (int y = -1; y <= 1; ++y) {
        for (int x = -1; x <= 1; ++x) {
            ivec2 p = clamp(uvi + ivec2(x, y), ivec2(0), size - ivec2(1));
            v = min(v, texelFetch(cloud_shadow_raw_tex, p, 0).r);
        }
    }
    return v;
}

float current_max_3x3(ivec2 uvi, ivec2 size) {
    float v = texelFetch(cloud_shadow_raw_tex, uvi, 0).r;
    for (int y = -1; y <= 1; ++y) {
        for (int x = -1; x <= 1; ++x) {
            ivec2 p = clamp(uvi + ivec2(x, y), ivec2(0), size - ivec2(1));
            v = max(v, texelFetch(cloud_shadow_raw_tex, p, 0).r);
        }
    }
    return v;
}

void main() {
    ivec2 uvi = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = imageSize(cloud_shadow_tex);
    if (any(greaterThanEqual(uvi, size))) {
        return;
    }

    float current = clamp(texelFetch(cloud_shadow_raw_tex, uvi, 0).r, 0.0, 1.0);

    bool disabled = gui_input.cloud_shadows_enabled == 0u || gui_input.clouds_enabled == 0u ||
                    gui_input.cloud_coverage <= 0.001 || gui_input.cloud_density <= 0.001;
    if (disabled || cloud_shadow_temporal_push.reset_history != 0u) {
        imageStore(cloud_shadow_tex, uvi, vec4(current, 0.0, 0.0, 1.0));
        return;
    }

    float history = clamp(texelFetch(cloud_shadow_history_tex, uvi, 0).r, 0.0, 1.0);

    // Neighborhood clamp in current raw transmittance space. This keeps temporal
    // accumulation from retaining stale cloud silhouettes after density/sun changes
    // while still averaging away the animated low-sample jitter.
    float n_min = current_min_3x3(uvi, size);
    float n_max = current_max_3x3(uvi, size);
    float n_range = n_max - n_min;
    float margin = max(n_range * 0.55, 0.025);
    history = clamp(history, n_min - margin, n_max + margin);

    float history_delta = abs(history - current);
    float change = smoothstep(0.035, 0.18, history_delta);

    // Cloud shadows can tolerate more lag than direct lighting, but they must
    // converge faster than visible clouds because receivers make ghosting obvious.
    float base_current_weight = clamp(gui_input.cloud_temporal_alpha * 4.0, 0.10, 0.35);
    float current_weight = mix(base_current_weight, 0.70, change);

    // Clear back to unshadowed quickly so old dark lobes do not linger.
    if (n_min > 0.995) {
        current_weight = 1.0;
    }

    float resolved = mix(history, current, current_weight);
    imageStore(cloud_shadow_tex, uvi, vec4(clamp(resolved, 0.0, 1.0), 0.0, 0.0, 1.0));
}
