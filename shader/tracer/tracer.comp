bool scene_hit(inout MarchingResult o_res, vec3 o, vec3 d, ivec3 map_pos, uvec4 scene_tex_read) {
    // see update_scene_tex.comp for encoding part
    if (scene_tex_read.x == 0) {
        return false;
    }
    scene_tex_read -= 1;

    ContreeMarchingResult contree_res =
        contree_marching(o, d, map_pos, vec3(1.0), false, scene_tex_read.x, scene_tex_read.y);
    if (contree_res.is_hit) {
        uint voxel_data       = contree_leaf_data.data[contree_res.voxel_addr];
        o_res.is_hit          = true;
        o_res.pos             = contree_res.pos;
        o_res.center_pos      = contree_res.center_pos;
        o_res.is_normal_valid = voxel_normal_valid_from_data(voxel_data);
        o_res.normal          = unpack_normal_v2(voxel_normal_bits_from_data(voxel_data));
        o_res.voxel_type      = voxel_type_from_data(voxel_data);
        o_res.hash_id         = voxel_hash_from_data(voxel_data);
        o_res.voxel_addr      = contree_res.voxel_addr;
        return true;
    }
    return false;
}
#include "../include/dda_scene_marching.glsl"

#include "../include/core/transform.glsl"

MarchingResult general_scene_marching(Ray ray) {
    return dda_scene_marching(ray.origin, ray.direction, ray.inv_direction);
}

vec3 sample_diffuse_bounce(ivec3 seed, vec3 normal) {
    vec3 weighted_cosine_bn = random_weighted_cosine_bn(seed);
    mat3 tbn                = make_tbn(normal);
    return tbn * weighted_cosine_bn;
}

vec3 sample_sun_disk(ivec3 seed, float sun_size, vec3 sun_dir) {
    vec2 random_xy = random_weighted_cosine_bn(seed).xy;
    random_xy *= sun_size;
    mat3 tbn = make_tbn(sun_dir);
    return normalize(sun_dir + tbn * vec3(random_xy.xy, 0.0));
}

/// If the ray hits the scene, no light, otherwise sunlight
vec3 get_shadow_ray_color(Ray ray, ivec3 seed) {
    float sun_above_horizon = step(0.0, sun_info.sun_dir.y);
    float terrain_shadow = get_shadow_weight_pcss(ray.origin, seed);
    float leaf_shadow = get_leaf_shadow_transmittance(vec4(ray.origin, 1.0), true, true);
    float cloud_shadow = get_cloud_shadow_transmittance(vec4(ray.origin, 1.0));
    return terrain_shadow * leaf_shadow * cloud_shadow * sun_info.sun_color * sun_info.sun_luminance *
           sun_above_horizon;
}

vec3 choose_random_normal(ivec3 seed);
void parse_trace_result(out vec3 albedo, out vec3 next_tracing_pos, MarchingResult res);

vec3 calc_direct_lighting(vec3 albedo, vec3 normal, vec3 next_tracing_pos, ivec3 seed) {
    Ray shadow_ray;
    shadow_ray.direction     = sample_sun_disk(seed, sun_info.sun_size, sun_info.sun_dir);
    shadow_ray.inv_direction = vec3(1.0) / shadow_ray.direction;
    shadow_ray.origin        = next_tracing_pos;

    float cos_i = dot(shadow_ray.direction, normal);
    if (cos_i <= 0.0) {
        return vec3(0.0);
    }

    // we ignored the pdf and brdf calc here, because the sun's luminance is experimental
    return get_shadow_ray_color(shadow_ray, seed) * cos_i * albedo;
}

vec3 calc_indirect_lighting(vec3 albedo, vec3 primary_normal, vec3 next_tracing_pos, ivec3 seed) {
    ivec3 indirect_seed = ivec3((seed.xy + ivec2(13, 37)) % 128, seed.z);

    Ray indirect_ray;
    indirect_ray.direction     = sample_diffuse_bounce(indirect_seed, primary_normal);
    indirect_ray.inv_direction = vec3(1.0) / indirect_ray.direction;
    indirect_ray.origin        = next_tracing_pos;

    MarchingResult res_indirect_ray = general_scene_marching(indirect_ray);
    if (!res_indirect_ray.is_hit) {
        return vec3(0.0);
    }

    if (!res_indirect_ray.is_normal_valid) {
        res_indirect_ray.normal = choose_random_normal(indirect_seed);
    }

    vec3 sample_albedo, sample_next_tracing_pos;
    parse_trace_result(sample_albedo, sample_next_tracing_pos, res_indirect_ray);

    Ray indirect_shadow_ray;
    indirect_shadow_ray.direction =
        sample_sun_disk(indirect_seed, sun_info.sun_size, sun_info.sun_dir);
    indirect_shadow_ray.inv_direction = vec3(1.0) / indirect_shadow_ray.direction;
    indirect_shadow_ray.origin        = sample_next_tracing_pos;

    float cos_indirect = dot(indirect_shadow_ray.direction, res_indirect_ray.normal);
    if (cos_indirect <= 0.0) {
        return vec3(0.0);
    }

    vec3 bounced =
        get_shadow_ray_color(indirect_shadow_ray, indirect_seed) * cos_indirect * sample_albedo;
    return bounced * albedo;
}

vec3 get_next_tracing_pos(vec3 voxel_center_pos, vec3 voxel_normal) {
    // gives more accurate out dir to avoid self shadowing
    vec2 t                = slabs(vec3(-1.0), vec3(1.0), vec3(0.0), 1.0 / voxel_normal);
    float half_voxel_size = 1.0 / 512.0; // assuming the voxel size is 1/512
    // 0.005 is experimental to maintain a good shadow quality
    vec3 march_extent = voxel_normal * (t.y * half_voxel_size + 0.005);
    return voxel_center_pos + march_extent;
}

vec3 get_lambertian_brdf(vec3 albedo) { return albedo * INV_PI; }

vec3 offset_color(vec3 input_color, vec3 center_pos) {
    const float HUE_AMPLITUDE   = 0.15; // max ±0.15
    const float SAT_AMPLITUDE   = 0.05;
    const float VALUE_AMPLITUDE = 0.05;

    vec3 hsv = rgb_to_hsv(input_color);
    vec3 rnd = hash_33(center_pos) - 0.5; // now in (-0.5, 0.5)

    hsv.x += rnd.x * HUE_AMPLITUDE;
    hsv.y += rnd.y * SAT_AMPLITUDE;
    hsv.z += rnd.z * VALUE_AMPLITUDE;

    hsv = clamp(hsv, 0.0, 1.0);
    return hsv_to_rgb(hsv);
}

void parse_trace_result(out vec3 albedo, out vec3 next_tracing_pos, MarchingResult res) {
    albedo = voxel_color_by_type_and_hash_unorm(res.voxel_type, res.hash_id);
    albedo = apply_terrain_moisture(albedo, res.voxel_type, res.center_pos);
    // albedo = offset_color(albedo, res.center_pos);
    next_tracing_pos = get_next_tracing_pos(res.center_pos, res.normal);
}

vec3 choose_random_normal(ivec3 seed) {
    return random_unit_vec3_bn(seed);

    vec2 rand_vec = random_unit_vec2_bn(seed);
    return vec3(rand_vec.x, 0.0,
                rand_vec.y); // This is a 2D random vector projected onto the XZ plane.
}

bool tree_preview_billboard_hit(Ray ray, out float o_t, out vec3 o_pos, out vec3 o_normal,
                                out vec3 o_color) {
    o_t      = 0.0;
    o_pos    = vec3(0.0);
    o_normal = vec3(0.0, 0.0, 1.0);
    o_color  = vec3(0.0);

    if (terrain_edit_preview.enabled == 0u || terrain_edit_preview.shape != 2u ||
        terrain_edit_preview.radius <= 0.0) {
        return false;
    }

    float height = max(terrain_edit_preview.radius * 2.6, 0.16);
    float half_width = height * 0.34;
    vec3 billboard_center = terrain_edit_preview.center + vec3(0.0, height * 0.58, 0.0);

    vec3 to_camera = normalize(camera_info.pos.xyz - billboard_center);
    if (dot(to_camera, to_camera) <= 1.0e-6) {
        to_camera = -ray.direction;
    }
    vec3 up = vec3(0.0, 1.0, 0.0);
    vec3 right = normalize(cross(up, to_camera));
    if (dot(right, right) <= 1.0e-6) {
        right = vec3(1.0, 0.0, 0.0);
    }
    vec3 normal = normalize(cross(right, up));
    if (dot(normal, to_camera) < 0.0) {
        normal = -normal;
    }

    float denom = dot(ray.direction, normal);
    if (abs(denom) <= 1.0e-5) {
        return false;
    }

    float t = dot(billboard_center - ray.origin, normal) / denom;
    if (t <= 0.0) {
        return false;
    }

    vec3 hit = ray.origin + ray.direction * t;
    vec3 local = hit - billboard_center;
    float x = dot(local, right);
    float y = dot(local, up);

    float normalized_y = (y + height * 0.5) / height;
    if (normalized_y < 0.0 || normalized_y > 1.0) {
        return false;
    }

    float triangle_half_width = half_width * (1.0 - normalized_y);
    if (abs(x) > triangle_half_width) {
        return false;
    }

    float edge = smoothstep(0.0, 0.10, min(normalized_y, 1.0 - abs(x) / max(triangle_half_width, 1.0e-4)));
    vec3 trunk_color = vec3(0.45, 0.25, 0.11);
    vec3 leaf_color = mix(vec3(0.16, 0.34, 0.16), terrain_edit_preview.color, 0.65);
    vec3 color = leaf_color * mix(0.72, 1.12, normalized_y) * edge;

    float trunk_half_width = half_width * 0.15;
    bool trunk = y < -height * 0.22 && abs(x) < trunk_half_width;
    if (trunk) {
        color = trunk_color;
    }

    o_t      = t;
    o_pos    = hit;
    o_normal = normal;
    o_color  = color;
    return true;
}

float depth_01_from_world_pos(vec3 world_pos) {
    vec4 point_ndc = camera_info.view_proj_mat * vec4(world_pos, 1.0);
    return point_ndc.z / point_ndc.w;
}

void output_tree_preview_billboard(out vec3 o_color, out float o_depth_01,
                                   out vec3 o_primary_normal,
                                   out vec3 o_primary_position,
                                   out uint o_primary_vox_id, out bool o_primary_is_hit,
                                   vec3 preview_color, vec3 preview_pos, vec3 preview_normal) {
    o_depth_01         = depth_01_from_world_pos(preview_pos);
    o_color            = preview_color;
    o_primary_normal   = preview_normal;
    o_primary_position = preview_pos;
    o_primary_vox_id   = 0;
    o_primary_is_hit   = true;
}

void get_pixel_color(out vec3 o_color, out float o_depth_01, out vec3 o_primary_normal,
                     out vec3 o_primary_position, out uint o_primary_vox_id,
                     out bool o_primary_is_hit, Ray ray, ivec3 seed) {
    float preview_t;
    vec3 preview_pos;
    vec3 preview_normal;
    vec3 preview_color;
    bool preview_hit = tree_preview_billboard_hit(ray, preview_t, preview_pos, preview_normal,
                                                  preview_color);

    MarchingResult res_primary_ray = general_scene_marching(ray);

    if (!res_primary_ray.is_hit) {
        if (preview_hit) {
            output_tree_preview_billboard(o_color, o_depth_01, o_primary_normal,
                                          o_primary_position, o_primary_vox_id,
                                          o_primary_is_hit, preview_color, preview_pos,
                                          preview_normal);
            return;
        }

        o_depth_01         = 1.0;
        o_color            = vec3(0.0);
        o_primary_normal   = vec3(0.0);
        o_primary_position = vec3(0.0);
        o_primary_vox_id   = 0;
        o_primary_is_hit   = false;
        return;
    }

    if (preview_hit && preview_t < length(res_primary_ray.pos - ray.origin)) {
        output_tree_preview_billboard(o_color, o_depth_01, o_primary_normal, o_primary_position,
                                      o_primary_vox_id, o_primary_is_hit, preview_color,
                                      preview_pos, preview_normal);
        return;
    }

    float primary_depth_01 = depth_01_from_world_pos(res_primary_ray.pos);

    o_depth_01         = primary_depth_01;
    o_primary_normal   = res_primary_ray.normal;
    o_primary_position = res_primary_ray.pos;
    o_primary_vox_id   = res_primary_ray.voxel_addr;
    o_primary_is_hit   = true;

    // if normal is not valid, change the res.normal to a random one
    if (!res_primary_ray.is_normal_valid) {
        res_primary_ray.normal = choose_random_normal(seed);
    }

    vec3 albedo, next_tracing_pos;
    parse_trace_result(albedo, next_tracing_pos, res_primary_ray);

    vec3 ambient_color = shading_info.ambient_light * albedo;
    vec3 direct_color =
        calc_direct_lighting(albedo, res_primary_ray.normal, next_tracing_pos, seed);
    vec3 indirect_color =
        gui_input.debug_bool != 0u
            ? calc_indirect_lighting(albedo, res_primary_ray.normal, next_tracing_pos, seed)
            : vec3(0.0);

    o_color = ambient_color + direct_color + indirect_color;

    // The edit brush is a UI affordance, not terrain material. Apply it after lighting so its
    // apparent strength does not depend on which side of the voxel terrain faces the sun.
    o_color = apply_terrain_edit_preview_tint(o_color, res_primary_ray.center_pos);
}

void main() {
    ivec2 uvi      = ivec2(gl_GlobalInvocationID.xy);
    ivec2 img_size = imageSize(compute_output_tex);
    if (any(greaterThanEqual(uvi, img_size))) {
        return;
    }

    ivec3 seed     = get_seed(env_info.frame_serial_idx);
    vec2 screen_uv = (vec2(gl_GlobalInvocationID.xy) + vec2(0.5)) / vec2(img_size);
    Ray ray        = ray_gen(screen_uv, camera_info.view_proj_mat_inv);

    vec3 color;
    float depth_01;
    vec3 primary_normal;
    vec3 primary_position;
    uint primary_vox_id;
    bool primary_is_hit;
    get_pixel_color(color, depth_01, primary_normal, primary_position, primary_vox_id,
                    primary_is_hit, ray, seed);

    vec2 uv_prev = project_world_to_screen(primary_position, camera_info_prev_frame.view_proj_mat);
    // directly using screen_uv will cause precision issue
    vec2 uv_cur     = project_world_to_screen(primary_position, camera_info.view_proj_mat);
    vec2 motion_vec = uv_prev - uv_cur;

    imageStore(compute_output_tex, uvi, uvec4(pack_rgbe(color), 0, 0, 0));
    imageStore(compute_depth_tex, uvi, vec4(depth_01, 0.0, 0.0, 1.0));

    imageStore(denoiser_normal_tex, uvi, uvec4(pack_normal_v2(primary_normal), 0, 0, 0));
    imageStore(denoiser_position_tex, uvi, vec4(primary_position, 1.0));
    imageStore(denoiser_vox_id_tex, uvi, uvec4(primary_vox_id, 0, 0, 0));
    imageStore(denoiser_motion_tex, uvi, vec4(motion_vec, 0.0, 0.0));
    imageStore(denoiser_hit_tex, uvi, uvec4(primary_is_hit ? 1 : 0, 0, 0, 1));
}
