+//! Temporary wall-clock scopes for the courtyard startup investigation.
+use std::{
+    cell::RefCell,
+    sync::{
+        atomic::{AtomicU64, Ordering},
+        OnceLock,
+    },
+    time::Instant,
+};
+thread_local! { static STACK: RefCell<Vec<u64>> = const { RefCell::new(Vec::new()) }; }
+static NEXT: AtomicU64 = AtomicU64::new(1);
+static ENABLED: OnceLock<bool> = OnceLock::new();
+pub(crate) fn enabled() -> bool {
+    *ENABLED.get_or_init(|| std::env::var_os("RE_FLORA_STARTUP_PROBE").is_some())
+}
+pub(crate) struct Span(Option<(u64, u64, Instant, String)>);
+pub(crate) fn span(label: impl Into<String>) -> Span {
+    if !enabled() {
+        return Span(None);
+    }
+    let id = NEXT.fetch_add(1, Ordering::Relaxed);
+    let parent = STACK.with(|s| {
+        let mut s = s.borrow_mut();
+        let parent = s.last().copied().unwrap_or(0);
+        s.push(id);
+        parent
+    });
+    Span(Some((id, parent, Instant::now(), label.into())))
+}
+/// Read-only replay after the authoritative naive admission has succeeded.
+/// Its answer is never substituted into planting and no world data is changed.
+pub(crate) fn replay_clearance(cones: &[crate::geom::RoundCone], points: &[glam::Vec3]) {
+    use crate::geom::RoundConeClearanceIndex;
+    let replay_probe = span("diagnostic.clearance_bvh_replay");
+    let started = Instant::now();
+    let index = RoundConeClearanceIndex::new(cones);
+    let build_ms = started.elapsed().as_secs_f64() * 1000.;
+    let started = Instant::now();
+    let hits = points
+        .iter()
+        .filter(|&&p| {
+            index
+                .nearest_cone(p)
+                .is_some_and(|i| cones[i].signed_distance(p) <= 0.)
+        })
+        .count();
+    let query_ms = started.elapsed().as_secs_f64() * 1000.;
+    assert_eq!(
+        hits, 0,
+        "replay must match the authoritative successful admission"
+    );
+    log::info!("[STARTUP_PROBE_REPLAY] points={} build_ms={build_ms:.6} query_ms={query_ms:.6} mismatches={hits}", points.len());
+    drop(replay_probe);
+    let _fixture_probe = span("diagnostic.clearance_boundary_fixtures");
+    let mut fixtures = 0;
+    let mut mismatches = 0;
+    for cone in cones {
+        for p in [
+            cone.center_a(),
+            cone.center_b(),
+            cone.center_a() + glam::Vec3::X * cone.radius_a(),
+            cone.aabb().min(),
+        ] {
+            let naive = cones.iter().any(|c| c.signed_distance(p) <= 0.);
+            let accelerated = index
+                .nearest_cone(p)
+                .is_some_and(|i| cones[i].signed_distance(p) <= 0.);
+            fixtures += 1;
+            mismatches += usize::from(naive != accelerated);
+        }
+    }
+    assert_eq!(mismatches, 0, "boundary fixture replay mismatch");
+    log::info!("[STARTUP_PROBE_REPLAY] boundary_fixtures={fixtures} mismatches={mismatches}");
+}
+
+impl Drop for Span {
+    fn drop(&mut self) {
+        if let Some((id, parent, start, label)) = self.0.take() {
+            let ms = start.elapsed().as_secs_f64() * 1000.;
+            STACK.with(|s| assert_eq!(s.borrow_mut().pop(), Some(id)));
+            log::info!(
+                "[STARTUP_PROBE] id={id} parent={parent} label={label} ms={ms:.6} thread={:?}",
+                std::thread::current().id()
+            );
+        }
+    }
+}
